{% extends "platform_layout.twig" %}

{% block title %}Yapay Zeka (AI) Ayarları | Platform{% endblock %}

{% block page_title %}Yapay Zeka (AI) Modül Ayarları{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12 col-xl-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white pb-0 border-bottom-0 pt-4 px-4">
                    <h5 class="mb-0 text-muted"><i class="bi bi-robot text-primary me-2"></i>Platform Geneli LLM (Dil Modeli) Yapılandırması</h5>
                    <p class="text-muted small mt-2">
                        Buradan tanımladığınız model ve komutlar (prompt), tüm kliniklerdeki **AI Hasta Özeti** işlemi için varsayılan motor olarak kullanılacaktır. Test edilmemiş modeller klinik tarafında üretimi bozabilir.
                    </p>
                </div>
                <div class="card-body p-4">
                    <form id="aiSettingsForm">
                        
                        <div class="row g-4">
                            <!-- LLM Model Selection -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">LLM Model Adı <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" name="model_name" placeholder="Örn: gemini-2.5-flash" required>
                                <div class="form-text">Şu an sadece Google Gemini modelleri tam desteklenmektedir.</div>
                            </div>

                            <!-- API Key -->
                            <div class="col-md-6">
                                <label class="form-label fw-bold">Model API Anahtarı (API Key)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                                    <input type="password" class="form-control" name="api_key" id="apiKeyInput" placeholder="Sadece değiştirmek istiyorsanız giriniz">
                                </div>
                                <div class="form-text" id="apiKeyHelpText">API anahtarı yükleniyor...</div>
                            </div>

                            <!-- System Prompt -->
                            <div class="col-12">
                                <label class="form-label fw-bold">Sistem Talimatı (System Prompt) <span class="text-danger">*</span></label>
                                <textarea class="form-control font-monospace text-sm" name="system_prompt" rows="6" required placeholder="Sen tecrübeli bir tıp asistanısın..."></textarea>
                                <div class="form-text">
                                    <i class="bi bi-info-circle text-primary"></i> Yapay zekaya kimliğine ve nasıl formatta çıktı üreteceğine dair vereceğiniz ana emirdir.
                                </div>
                            </div>
                            
                            <!-- Status -->
                            <div class="col-12">
                                <div class="form-check form-switch mt-2">
                                    <input class="form-check-input" type="checkbox" id="isActiveSwitch" name="is_active" checked>
                                    <label class="form-check-label fw-bold" for="isActiveSwitch">Tüm platformda AI özelliklerini aktif et</label>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4 pt-3 border-top">
                            <button type="button" class="btn btn-primary px-4" id="saveBtn" onclick="saveSettings()">
                                <i class="bi bi-check-lg me-2"></i> Ayarları Kaydet
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
        
        <!-- Info Card -->
        <div class="col-12 col-xl-4 mt-4 mt-xl-0">
            <div class="card bg-primary bg-opacity-10 border-primary border-opacity-25 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title text-primary"><i class="bi bi-shield-check me-2"></i>Gizlilik ve Güvenlik</h5>
                    <p class="card-text text-sm mt-3">
                        Hastaların platform üzerinde tutulan kişisel verileri (TC No, İsim, Telefon, E-posta) <strong>asla</strong> LLM modellerine (Gemini) gönderilmez.
                    </p>
                    <ul class="text-sm ps-3">
                        <li>Hastalar anonimleştirilerek sadece YAS, CINSIYET gibi demografik kırılımlarla aktarılır.</li>
                        <li>Yalnızca kliniğin girdiği teşhis (ICD-10) ve açık metin muayene bulguları (Anamnez vb.) özetlenir.</li>
                        <li>Model API anahtarınız veritabanında tamamen AES-256-GCM ile şifrelenmiş olarak tutulur. Asla geriye açık şekilde okunamaz.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
    const API_BASE = '{{ base_path }}/platform-admin/settings/ai';
    
    document.addEventListener('DOMContentLoaded', () => {
        loadSettings();
    });

    async function loadSettings() {
        try {
            const res = await axios.get(API_BASE, {
                headers: { 'Authorization': `Bearer ${localStorage.getItem('platform_token')}` }
            });
            
            const settings = res.data.data;
            if (settings) {
                const form = document.getElementById('aiSettingsForm');
                
                form.querySelector('[name=model_name]').value = settings.model_name || '';
                form.querySelector('[name=system_prompt]').value = settings.system_prompt || '';
                form.querySelector('[name=is_active]').checked = settings.is_active === 1;

                const helpText = document.getElementById('apiKeyHelpText');
                if (settings.has_api_key) {
                    helpText.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i> Sistemde kayıtlı (şifrelenmiş) geçerli bir API anahtarı var. Sadece değiştirmek istiyorsanız yukarıya yeni bir anahtar girin.</span>';
                } else {
                    helpText.innerHTML = '<span class="text-danger"><i class="bi bi-exclamation-triangle-fill"></i> Henüz API Anahtarı girilmemiş. AI özellikleri çalışmayacaktır.</span>';
                }
            }
        } catch (e) {
            console.error(e);
            Utils.showToast('Ayarlar yüklenirken bir hata oluştu', 'error');
            document.getElementById('apiKeyHelpText').innerHTML = 'Hata oluştu.';
        }
    }

    async function saveSettings() {
        const form = document.getElementById('aiSettingsForm');
        
        const modelName = form.querySelector('[name=model_name]').value.trim();
        const systemPrompt = form.querySelector('[name=system_prompt]').value.trim();
        const apiKey = form.querySelector('[name=api_key]').value.trim();
        const isActive = form.querySelector('[name=is_active]').checked;

        if (!modelName || !systemPrompt) {
            Utils.showToast('Lütfen zorunlu alanları (*) doldurun.', 'warning');
            return;
        }

        const payload = {
            model_name: modelName,
            system_prompt: systemPrompt,
            is_active: isActive
        };

        if (apiKey) {
            payload.api_key = apiKey;
        }

        const btn = document.getElementById('saveBtn');
        const originalText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Kaydediliyor...';

        try {
            await axios.put(API_BASE, payload, {
                headers: { 'Authorization': `Bearer ${localStorage.getItem('platform_token')}` }
            });
            
            Swal.fire('Başarılı', 'Yapay zeka ayarları platforma kaydedildi.', 'success');
            
            // Eğer yeni bir key kaydedildiyse input'u tekrar temizle
            if (apiKey) {
                form.querySelector('[name=api_key]').value = '';
                document.getElementById('apiKeyHelpText').innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i> Sistemde kayıtlı (şifrelenmiş) geçerli bir API anahtarı var. Sadece değiştirmek istiyorsanız yukarıya yeni bir anahtar girin.</span>';
            }
            
        } catch (e) {
            const msg = e.response?.data?.error?.message || 'Kaydetme işlemi başarısız.';
            Swal.fire('Hata', msg, 'error');
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalText;
        }
    }
</script>
{% endblock %}
