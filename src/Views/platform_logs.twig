<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pozitif Klinik - Sistem Logları">
    <title>Sistem Logları | Pozitif Klinik Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="{{ base_path }}/assets/css/dashboard.css?v={{ version }}" rel="stylesheet">
    
    <style>
        .filter-card {
            background: white;
            border-radius: 16px;
            padding: 24px;
            box-shadow: var(--card-shadow);
            margin-bottom: 24px;
        }

        .log-container {
            background: #1e293b;
            border-radius: 16px;
            overflow: hidden;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.3);
            display: flex;
            flex-direction: column;
            height: calc(100vh - 350px);
            min-height: 500px;
        }

        .log-header {
            background: #0f172a;
            padding: 12px 20px;
            border-bottom: 1px solid #334155;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .log-header-title {
            color: #94a3b8;
            font-size: 0.85rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin: 0;
        }

        .log-body {
            flex: 1;
            overflow-y: auto;
            padding: 10px 0;
            font-family: 'JetBrains Mono', monospace;
            font-size: 0.85rem;
            line-height: 1.5;
        }

        .log-entry {
            padding: 4px 20px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.03);
            display: flex;
            gap: 12px;
            transition: background 0.2s;
            cursor: pointer;
            white-space: pre-wrap;
        }

        .log-entry:hover {
            background: rgba(255, 255, 255, 0.05);
        }

        .log-time {
            color: #64748b;
            flex-shrink: 0;
            width: 180px;
        }

        .log-level {
            width: 80px;
            flex-shrink: 0;
            font-weight: 700;
            text-align: center;
            border-radius: 4px;
            padding: 0 4px;
            font-size: 0.75rem;
            height: fit-content;
        }

        .level-info { background: #0ea5e9; color: white; }
        .level-error { background: #ef4444; color: white; }
        .level-warning { background: #f59e0b; color: white; }
        .level-debug { background: #64748b; color: white; }
        .level-critical { background: #7f1d1d; color: white; }

        .log-message {
            color: #e2e8f0;
            word-break: break-word;
        }

        .log-details {
            display: none;
            background: #0f172a;
            margin: 10px 20px;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #334155;
            color: #94a3b8;
        }

        .log-entry.expanded + .log-details {
            display: block;
        }

        .log-entry.expanded {
            background: rgba(255, 255, 255, 0.08);
            border-left: 4px solid var(--primary-gradient-start);
        }

        /* Custom Scrollbar */
        .log-body::-webkit-scrollbar {
            width: 10px;
        }
        .log-body::-webkit-scrollbar-track {
            background: #0f172a;
        }
        .log-body::-webkit-scrollbar-thumb {
            background: #334155;
            border-radius: 5px;
        }
        .log-body::-webkit-scrollbar-thumb:hover {
            background: #475569;
        }

        .badge-count {
            background: rgba(255, 255, 255, 0.1);
            color: #94a3b8;
            padding: 2px 8px;
            border-radius: 12px;
            font-size: 0.75rem;
            margin-left: 8px;
        }

        .search-container {
            position: relative;
        }

        .search-container i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-secondary);
        }

        .search-container input {
            padding-left: 36px;
        }
    </style>
</head>

<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="{{ base_path }}/platform/dashboard" class="sidebar-logo">
                <div class="sidebar-logo-icon"><i class="bi bi-hospital"></i></div>
                <div class="sidebar-logo-text">Pozitif<span>Platform Yönetimi</span></div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">Ana Menü</div>
                <a href="{{ base_path }}/platform/dashboard" class="nav-link-custom">
                    <i class="bi bi-building"></i>Klinikler
                </a>
                <a href="#" class="nav-link-custom"><i class="bi bi-people"></i>Kullanıcılar</a>
                <a href="#" class="nav-link-custom"><i class="bi bi-bar-chart"></i>İstatistikler</a>
            </div>
            <div class="nav-section">
                <div class="nav-section-title">Sistem</div>
                <a href="#" class="nav-link-custom"><i class="bi bi-gear"></i>Ayarlar</a>
                <a href="{{ base_path }}/platform/logs" class="nav-link-custom active"><i class="bi bi-file-text"></i>Loglar</a>
            </div>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="top-navbar">
            <h1 class="navbar-title">Sistem Logları</h1>
            <div class="navbar-actions">
                <button class="btn-logout" id="logoutBtn"><i class="bi bi-box-arrow-right"></i>Çıkış Yap</button>
            </div>
        </header>

        <div class="content-area">
            <!-- Filter Section -->
            <div class="filter-card">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label">Tarih</label>
                        <select class="form-select" id="logDateSelect">
                            <option value="{{ "now"|date("Y-m-d") }}">Bugün ({{ "now"|date("d.m.Y") }})</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Log Türü</label>
                        <select class="form-select" id="logLevelSelect">
                            <option value="ALL">Tümü</option>
                            <option value="ERROR">Hatalar</option>
                            <option value="WARNING">Uyarılar</option>
                            <option value="INFO">Bilgi</option>
                            <option value="DEBUG">Debug</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Arama</label>
                        <div class="search-container">
                            <i class="bi bi-search"></i>
                            <input type="text" class="form-control" id="logSearchInput" placeholder="Mesaj veya Trace ID ile ara...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">&nbsp;</label>
                        <button class="btn btn-save w-100" id="refreshLogsBtn">
                            <i class="bi bi-arrow-clockwise me-2"></i>Tazele
                        </button>
                    </div>
                </div>
            </div>

            <!-- Log Viewer Container -->
            <div class="log-container">
                <div class="log-header">
                    <h2 class="log-header-title">
                        Uygulama Logları 
                        <span class="badge-count" id="logCount">0 kayıt</span>
                    </h2>
                    <div>
                        <button class="btn btn-sm btn-outline-secondary text-white-50 border-secondary me-2" id="clearSearchBtn">
                            Filtreleri Temizle
                        </button>
                        <button class="btn btn-sm btn-outline-primary" id="expandAllBtn">
                            Hepsini Aç
                        </button>
                    </div>
                </div>
                <div class="log-body" id="logBody">
                    <!-- Logs will be loaded here -->
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Yükleniyor...</span>
                        </div>
                        <p class="text-secondary mt-3">Loglar yükleniyor...</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.2/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom JS -->
    <script src="{{ base_path }}/assets/js/config.js?v={{ version }}"></script>
    <script src="{{ base_path }}/assets/js/platform_logs.js?v={{ version }}"></script>
</body>
</html>
