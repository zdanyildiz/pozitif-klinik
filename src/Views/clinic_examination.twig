{% extends "layout.twig" %}

{% block title %}Muayene Ekranı | Pozitif Klinik{% endblock %}
{% block page_title %}Tıbbi Muayene ve Çalışma Alanı{% endblock %}

{% block head %}
    <link href="{{ base_path }}/assets/css/file-manager.css?v={{ version }}" rel="stylesheet">
    <link href="{{ base_path }}/assets/css/examination.css?v={{ version }}" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
{% endblock %}

{% block content %}
<div class="examination-container" id="examApp">
    <!-- Main Examination Sidebar (Left/Center) -->
    <div class="main-exam-card">
        <div class="exam-header">
            <div class="patient-brief">
                <div class="patient-avatar-circle" id="patientInitial">?</div>
                <div class="overflow-hidden">
                    <h5 class="mb-0 fw-bold text-truncate" id="patientNameDisplay">Yükleniyor...</h5>
                    <small class="text-muted d-block" id="patientSubInfo">Randevu ID: #{{ appointment_id }}</small>
                </div>
            </div>
            <div class="exam-actions">
                {# Epikriz Yazdırma Dropdown #}
                <div class="btn-group" id="epicrisisGroup" style="display: none;">
                    <button type="button" class="btn btn-outline-success btn-sm dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" id="btnEpicrisis">
                        <i class="bi bi-file-earmark-medical"></i>
                        <span class="ms-1 d-none d-sm-inline">Epikriz</span>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end" style="min-width: 280px;">
                        <li><h6 class="dropdown-header"><i class="bi bi-file-text me-1"></i> Şablon Seçin (Taslak Önizle)</h6></li>
                        <li id="epicrisisTemplateList">
                            <a class="dropdown-item text-muted" href="#">Yükleniyor...</a>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="bi bi-check-circle me-1"></i> Kesinleştir</h6></li>
                        <li>
                            <a class="dropdown-item text-success fw-bold" href="#" id="btnSaveEpicrisis">
                                <i class="bi bi-file-earmark-check me-2"></i>Onayla ve Kaydet
                                <small class="d-block text-muted fw-normal">Kalıcı PDF oluşturur</small>
                            </a>
                        </li>
                    </ul>
                </div>

                <button class="btn btn-outline-info btn-sm ms-2" id="btnShowAiSummary" onclick="openExamAiSummaryModal()" style="display: none;">
                    <i class="bi bi-robot"></i>
                    <span class="ms-1 d-none d-sm-inline">AI Özeti</span>
                </button>

                <button class="btn btn-outline-primary btn-sm ms-2" id="btnShowBilling">
                    <i class="bi bi-receipt"></i>
                    <span class="ms-1 d-none d-sm-inline">Hizmet & Ücret</span>
                </button>
                <button class="btn btn-outline-secondary btn-sm ms-2" onclick="history.back()">
                    <i class="bi bi-arrow-left"></i>
                    <span class="ms-1 d-none d-sm-inline">Geri Dön</span>
                </button>
            </div>
        </div>

        <div class="exam-body">
            <form id="examinationForm">
                <input type="hidden" name="appointment_id" value="{{ appointment_id }}">
                <input type="hidden" name="patient_id" id="patientIdInput">
                <input type="hidden" name="id" id="examinationIdInput">

                <!-- Şikayet ve Öykü -->
                <div class="row">
                    <div class="col-md-6">
                        <div class="exam-section">
                            <label class="section-title"><i class="bi bi-chat-dots"></i> Şikayet</label>
                            <textarea class="form-control-exam w-100" name="complaint" id="complaint" placeholder="Hastanın geliş sebebi..."></textarea>
                            <div class="quick-btns">
                                <button type="button" class="btn-quick" onclick="addText('complaint', 'Rutin kontrol')">Rutin kontrol</button>
                                <button type="button" class="btn-quick" onclick="addText('complaint', 'Ağrı şikayeti')">Ağrı şikayeti</button>
                                <button type="button" class="btn-quick" onclick="addText('complaint', 'Tetkik sonuç gösterme')">Tetkik sonuç</button>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="exam-section">
                            <label class="section-title"><i class="bi bi-journal-medical"></i> Hikaye (Anamnez)</label>
                            <textarea class="form-control-exam w-100" name="anamnez" id="anamnez" placeholder="Tıbbi geçmiş, alerjiler, alışkanlıklar..."></textarea>
                        </div>
                    </div>
                </div>

                <!-- Bulgular -->
                <div class="exam-section">
                    <label class="section-title"><i class="bi bi-stethoscope"></i> Muayene Bulguları</label>
                    <textarea class="form-control-exam w-100" name="bulgular" id="bulgular" placeholder="Fiziksel muayene sonuçları..."></textarea>
                </div>

                <!-- Tanı ve ICD-10 -->
                <div class="exam-section">
                    <label class="section-title"><i class="bi bi-patch-check"></i> Tanı (ICD-10)</label>
                    <div class="mb-3">
                        <select id="diagnosisSelect" class="form-select" placeholder="Tanı ara veya yaz..."></select>
                    </div>
                    <textarea class="form-control-exam w-100" name="diagnosis" id="diagnosis" placeholder="Kesin veya ön tanı..."></textarea>
                    <div class="quick-btns">
                        <button type="button" class="btn-quick" onclick="addText('diagnosis', 'Esansiyel (primer) hipertansiyon')">Hipertansiyon</button>
                        <button type="button" class="btn-quick" onclick="addText('diagnosis', 'Tip 2 diyabetes mellitüs')">Diyabet</button>
                        <button type="button" class="btn-quick" onclick="addText('diagnosis', 'Akut üst solunum yolu enfeksiyonu')">ÜSYE</button>
                    </div>
                </div>

                <!-- Tetkik Sonuçları (YENİ) -->
                <div class="exam-section">
                    <label class="section-title"><i class="bi bi-eyedropper"></i> Tetkik Sonuçları</label>
                    <textarea class="form-control-exam w-100" name="lab_result_text" id="lab_result_text" placeholder="Laboratuvar ve görüntüleme sonuçları..."></textarea>
                </div>

                <!-- Tedavi Planı -->
                <div class="exam-section">
                    <label class="section-title"><i class="bi bi-capsule-pill"></i> Tedavi ve Plan</label>
                    <textarea class="form-control-exam w-100" name="treatment" id="treatment" placeholder="İlaçlar, öneriler, istenecek tetkikler..."></textarea>
                </div>

                <!-- Sonuç Notu -->
                <div class="exam-section">
                    <label class="section-title"><i class="bi bi-flag"></i> Sonuç Notu</label>
                    <textarea class="form-control-exam w-100" name="result_note" id="result_note" placeholder="Kontrol tarihi, sevk durumu vb..."></textarea>
                </div>

                <!-- Dosyalar ve Ekler -->
                <div class="exam-section" id="examFilesSection">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <label class="section-title mb-0"><i class="bi bi-paperclip"></i> Muayene Dosyaları & Ekler</label>
                        <div id="examFileUploadContainer" style="display: none;">
                            <button type="button" id="exam_file_upload" class="btn btn-sm btn-outline-primary shadow-sm rounded-pill px-3">
                                <i class="bi bi-cloud-upload me-1"></i> Dosya Ekle
                            </button>
                        </div>
                    </div>
                    <div id="exam_file_list" class="bg-light rounded border p-2" style="min-height: 100px;">
                        <div class="text-center p-4 text-muted" id="examFilePlaceholder">
                            <i class="bi bi-info-circle me-1"></i> Muayene kaydedildikten sonra bu bölüme dosya ekleyebilirsiniz.
                        </div>
                    </div>
                </div>
            </form>
        </div>

        <div class="exam-footer">
            <div class="me-auto text-muted small mt-2">
                <i class="bi bi-clock-history"></i> Son Kaydetme: <span id="lastSavedTime">-</span>
            </div>
            <button class="btn btn-save-exam" id="btnSaveExamination">
                <i class="bi bi-check-circle me-1"></i> Muayeneyi Kaydet
            </button>
        </div>
    </div>

    <!-- History & Files Sidebar (Right) -->
    <div class="history-sidebar">
        <ul class="nav nav-tabs nav-fill sidebar-tabs" id="sidebarTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" id="history-tab" data-bs-toggle="tab" data-bs-target="#historyPane" type="button">
                    <i class="bi bi-clock-history me-1"></i> Geçmiş
                </button>
            </li>
            <li class="nav-item">
                <button class="nav-link" id="files-tab" data-bs-toggle="tab" data-bs-target="#filesPane" type="button">
                    <i class="bi bi-folder2-open me-1"></i> Arşiv
                </button>
            </li>
        </ul>
        
        <div class="tab-content sidebar-tab-content">
            <!-- History Pane -->
            <div class="tab-pane fade show active" id="historyPane" role="tabpanel">
                <div class="history-list" id="historyList">
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-hourglass-split mb-2 fs-3"></i>
                        <p class="small">Yükleniyor...</p>
                    </div>
                </div>
            </div>
            
            <!-- Files Archive Pane -->
            <div class="tab-pane fade" id="filesPane" role="tabpanel">
                <div class="archive-header d-flex justify-content-between align-items-center">
                    <span class="archive-title">HASTA DOSYA ARŞİVİ</span>
                    <button type="button" id="archive_file_upload" class="btn btn-sm btn-primary rounded-circle p-0 d-flex align-items-center justify-content-center" style="width: 28px; height: 28px;">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
                <div id="archive_file_list" class="p-1">
                    <div class="text-center py-5 text-muted small">
                        <i class="bi bi-files mb-2 fs-4 opacity-50"></i>
                        <p>Yükleniyor...</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Billing Modal (Shortcut) -->
<div class="modal fade" id="billingModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Hizmetler ve Ücretlendirme</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-column gap-3 mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h6 class="mb-0">Uygulanan Hizmetler & İşlemler</h6>
                        <button class="btn btn-sm btn-outline-primary" id="btnToggleServicePanel">
                            <i class="bi bi-plus-lg me-1"></i> Hizmet Ekle
                        </button>
                    </div>

                    <!-- Inline Service Selection Panel -->
                    <div id="serviceSelectionPanel" class="bg-light p-3 rounded" style="display: none;">
                        <label class="form-label small fw-bold text-muted">Hizmet Seçiniz:</label>
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                <select id="inlineServiceSelect" class="form-select" placeholder="Hizmet adı veya kodu ile arayın..."></select>
                            </div>
                            <button class="btn btn-success" id="btnConfirmAddService">
                                <i class="bi bi-check-lg"></i> Ekle
                            </button>
                        </div>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table billing-table">
                        <thead>
                            <tr>
                                <th>Hizmet / İşlem</th>
                                <th class="w-80p text-center">Adet</th>
                                <th class="text-end w-120p">Birim Fiyat</th>
                                <th class="text-end w-120p">Toplam</th>
                                <th class="w-50p"></th>
                            </tr>
                        </thead>
                        <tbody id="billingItemsBody">
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">Yükleniyor...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="billing-total d-flex justify-content-between mt-4">
                    <span>Genel Toplam</span>
                    <span id="billingGrandTotal">0,00 ₺</span>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- AI Özeti Modalı (Muayene Ekranı) -->
<div class="modal fade" id="examAiSummaryModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 1rem;">
            <div class="modal-header bg-primary bg-opacity-10 border-bottom-0 pb-3" style="border-radius: 1rem 1rem 0 0;">
                <h5 class="modal-title fw-bold text-light"><i class="bi bi-robot me-2 fs-4 align-middle"></i>Yapay Zeka Destekli Hasta Özeti</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4 bg-white">
                <div id="examAiSummaryNoConsent" style="display: none;">
                    <div class="alert alert-warning border-0 bg-warning-subtle text-warning-emphasis mb-0 p-4 rounded-3 text-center">
                        <i class="bi bi-exclamation-triangle-fill fs-2 d-block mb-3 text-warning"></i>
                        <h6 class="fw-bold">İzin Gerekli</h6>
                        <p class="mb-3 small">Hastanın yapay zeka özeti için "AI İzin Onayı" bulunmamaktadır. KVKK ve gizlilik standartları gereği veriler dış kaynaklara gönderilemez.</p>
                        <button class="btn btn-warning btn-sm fw-bold" onclick="window.open('/admin/patients/' + currentPatientId + '/edit', '_blank')">Profilden İzin Ekle</button>
                    </div>
                </div>

                <div id="examAiSummaryView" style="display: none;">
                    <!-- Gizlilik ve Güvenlik Bilgi Kutusu -->
                    <div class="alert alert-info border-0 bg-info-subtle border-start border-4 border-info mb-4 p-3 rounded-3 shadow-sm">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-shield-lock-fill text-primary fs-3 me-3"></i>
                            <div>
                                <h6 class="fw-bold mb-1 text-dark" style="font-size: 0.9rem;">Veri Gizliliği ve Güvenliği</h6>
                                <p class="mb-0 small text-muted">Hasta mahremiyeti gereği; <b>Ad-Soyad, TC Kimlik No, Telefon ve E-posta</b> gibi tanımlayıcı bilgiler kesinlikle yapay zeka modeline <u>gönderilmemektedir</u>. Sadece anonimleştirilmiş tıbbi muayene notları ve klinik bulgular analiz edilir.</p>
                            </div>
                        </div>
                    </div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-4 bg-light p-3 rounded-3 border">
                        <p class="mb-0 text-muted small pe-3" style="line-height: 1.5;">
                            <i class="bi bi-info-circle-fill text-primary me-1"></i>Bu özet, hastanın tıbbi geçmişindeki anonim veriler kullanılarak hazırlanır.
                        </p>
                         <button class="btn btn-primary px-4 rounded-pill shadow-sm text-nowrap" id="btnExamGenerateAiSummary" onclick="generateExamAiSummary()">
                            <i class="bi bi-magic me-1"></i> <span id="btnExamGenerateAiSummaryText">Özet Çıkar</span>
                        </button>
                    </div>

                    <!-- Özeti Gösterme Alanı -->
                    <div id="examAiSummaryContentBox" class="p-4 rounded-3 border bg-white shadow-sm" style="display: none;">
                        <div id="examAiSummaryMarkdown" class="text-dark" style="line-height: 1.7; font-size: 0.95rem;">-</div>
                        <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center text-muted small">
                            <span id="examAiSummaryCachedBadge" class="badge bg-secondary-subtle text-secondary border border-secondary fw-normal">Yapay Zeka Özetidir, hekim teyidi gerektirir</span>
                            <span id="examAiSummaryTimestamp"><i class="bi bi-clock me-1"></i>Son güncelleme: -</span>
                        </div>
                    </div>

                    <!-- Boş Durum (Artık içeride) -->
                    <div id="examAiSummaryEmptyState" class="text-center py-5 text-muted" style="display: none;">
                        <div class="d-inline-flex justify-content-center align-items-center rounded-circle bg-light mb-4" style="width: 80px; height: 80px;">
                            <i class="bi bi-robot fs-1 text-primary opacity-50"></i>
                        </div>
                        <h5 class="fw-bold text-dark">Henüz Özet Çıkarılmamış</h5>
                        <p class="mb-0 mx-auto" style="max-width: 400px;">Yukarıdaki butona tıklayarak geçmiş muayene kayıtlarından kapsamlı bir sağlık özeti oluşturabilirsiniz.</p>
                    </div>
                </div>

                <!-- Yükleniyor Durumu -->
                <div id="examAiSummaryLoading" class="text-center py-5" style="display: none;">
                    <div class="spinner-grow text-primary mb-4" role="status" style="width: 3rem; height: 3rem;"></div>
                    <h5 class="fw-bold text-primary mb-2">Veriler Analiz Ediliyor...</h5>
                    <p class="text-muted small mx-auto" style="max-width: 350px;">Hastanın klinik geçmişi ve tetkikleri incelenerek doktorun hızlı bir bakışta görebileceği özet hazırlanıyor.</p>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block scripts %}
    <script>
        window.csrfToken = '{{ csrf.value }}';
    </script>
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/js/tom-select.complete.min.js"></script>
    <script src="{{ base_path }}/assets/js/file-manager.js?v={{ version }}"></script>
    <script src="{{ base_path }}/assets/js/examination.js?v={{ version }}"></script>
    <script>
        // AI Summary Logic for Examination UI
        let examPatientConsentInfo = null;
        let ptnLoadTries = 0;

        // Sayfa ilk yüklendiğinde, currentPatientId set edildikten hemen sonra çalışmasını sağlamak için Interval veya Hook kullanılabilir.
        // Ancak examination.js initPageData kullanıyor. Biz de belli aralıklarla kontrol edip butonu aktif edebiliriz.
        const checkPatientInterval = setInterval(async () => {
            if (typeof currentPatientId !== 'undefined' && currentPatientId) {
                clearInterval(checkPatientInterval);
                try {
                    // Hastanın legal consent bilgisini kontrol et
                    const pRes = await api.get(`/api/patients/${currentPatientId}`);
                    examPatientConsentInfo = pRes.data.legal_consents?.ai_summary?.is_accepted;
                    
                    // Görünür yap
                    document.getElementById('btnShowAiSummary').style.display = 'inline-block';
                } catch(e) {
                    console.error("AI Consent Check error: ", e);
                }
            } else if (++ptnLoadTries > 20) {
                clearInterval(checkPatientInterval);
            }
        }, 500);

        async function openExamAiSummaryModal() {
            const modal = new bootstrap.Modal(document.getElementById('examAiSummaryModal'));
            modal.show();

            const noConsent = document.getElementById('examAiSummaryNoConsent');
            const viewPanel = document.getElementById('examAiSummaryView');
            const emptyState = document.getElementById('examAiSummaryEmptyState');
            const contentBox = document.getElementById('examAiSummaryContentBox');
            const loadingBox = document.getElementById('examAiSummaryLoading');

            // Reset UI
            noConsent.style.display = 'none';
            viewPanel.style.display = 'none';
            loadingBox.style.display = 'block';

            if (examPatientConsentInfo !== true) {
                loadingBox.style.display = 'none';
                noConsent.style.display = 'block';
                return;
            }

            try {
                // Get existing summary
                const res = await api.get(`/api/patients/${currentPatientId}/ai-summary`);
                loadingBox.style.display = 'none';
                viewPanel.style.display = 'block';

                if (res.data && res.data.has_summary) {
                    fillExamSummaryText(res.data.summary);
                    document.getElementById('btnExamGenerateAiSummaryText').innerText = 'Özeti Güncelle';
                    emptyState.style.display = 'none';
                    contentBox.style.display = 'block';
                } else {
                    document.getElementById('btnExamGenerateAiSummaryText').innerText = 'Özet Çıkar';
                    contentBox.style.display = 'none';
                    emptyState.style.display = 'block';
                }
            } catch(e) {
                loadingBox.style.display = 'none';
                viewPanel.style.display = 'block';
                document.getElementById('btnExamGenerateAiSummaryText').innerText = 'Özet Çıkar';
                contentBox.style.display = 'none';
                emptyState.style.display = 'block';
                Utils.showToast('Özet durumu kontrol edilemedi.', 'error');
            }
        }

        async function generateExamAiSummary(isFirst = false) {
            const viewPanel = document.getElementById('examAiSummaryView');
            const emptyState = document.getElementById('examAiSummaryEmptyState');
            const contentBox = document.getElementById('examAiSummaryContentBox');
            const loadingBox = document.getElementById('examAiSummaryLoading');

            viewPanel.style.display = 'none';
            loadingBox.style.display = 'block';

            try {
                const res = await api.post(`/api/patients/${currentPatientId}/ai-summary`, {});
                if (res && res.status) {
                    fillExamSummaryText({ summary_text: res.data.summary || '', created_at: new Date() });
                    
                    if (res.data.is_cached && !isFirst) {
                         Utils.showToast('Gelen yeni bir veri bulunmadığından özet değişmedi.', 'info');
                    } else {
                         Swal.fire({ title: 'Tamamlandı!', text: 'Hastanın özeti çıkarıldı.', icon: 'success', toast: true, position: 'top-end', showConfirmButton: false, timer: 3000 });
                    }
                    loadingBox.style.display = 'none';
                    
                    document.getElementById('btnExamGenerateAiSummaryText').innerText = 'Özeti Güncelle';
                    emptyState.style.display = 'none';
                    contentBox.style.display = 'block';
                    viewPanel.style.display = 'block';
                }
            } catch(e) {
                loadingBox.style.display = 'none';
                viewPanel.style.display = 'block';
                Utils.showError('Sistem hatası: Özet oluşturulamadı.');
            }
        }

        function fillExamSummaryText(summaryObj) {
            let htmlText = summaryObj.summary_text || '';
            // HTML Tag temizle & Markdown dönüştür (basitçe)
            if (!htmlText.includes('<p>') && !htmlText.includes('<br>') && !htmlText.includes('<strong>')) {
                htmlText = htmlText.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
                htmlText = htmlText.replace(/^### (.*$)/gim, '<h6 class="fw-bold text-primary mt-3">$1</h6>');
                htmlText = htmlText.replace(/^## (.*$)/gim, '<h5 class="fw-bold text-primary mt-3 border-bottom pb-2">$1</h5>');
                htmlText = htmlText.replace(/^# (.*$)/gim, '<h4 class="fw-bold text-primary mt-3 border-bottom pb-2">$1</h4>');
                htmlText = htmlText.replace(/^\* (.*$)/gim, '<li class="ms-3 mb-1"><i class="bi bi-circle-fill text-muted me-2" style="font-size: 6px; vertical-align: middle;"></i>$1</li>');
            }
            document.getElementById('examAiSummaryMarkdown').innerHTML = htmlText;
            
            const dp = summaryObj.created_at ? new Date(summaryObj.created_at) : new Date();
            const timeStr = dp.toLocaleDateString('tr-TR') + ' ' + dp.getHours().toString().padStart(2, '0') + ':' + dp.getMinutes().toString().padStart(2, '0');
            document.getElementById('examAiSummaryTimestamp').innerHTML = `<i class="bi bi-clock me-1"></i>Son güncelleme: ${timeStr}`;
        }
    </script>
{% endblock %}
