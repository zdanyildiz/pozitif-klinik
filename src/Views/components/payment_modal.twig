{# Payment Modal Component #}
<div class="modal fade" id="paymentModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content shadow-lg border-0">
            <div class="modal-header bg-white border-bottom">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-wallet2 me-2 text-primary"></i>Tahsilat Ekranı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="row g-0 h-100">
                    <!-- Check / Hizmet Detayları (Sol Taraf) -->
                    <div class="col-lg-8 p-4">
                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-list-check me-2"></i>Hizmetler ve Ücretler</h6>
                        

                        <!-- Item Breakdown -->
                        <div id="paymentItemsContainer" class="mb-4 text-sm"></div>

                        <!-- Genel İndirim Alanı -->
                        <div class="mt-auto pt-3 border-top">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="fw-bold text-muted small">Genel İndirim</span>
                                <button type="button" class="btn btn-sm btn-light border text-primary" id="btnToggleDiscount" onclick="toggleDiscountArea()">
                                    <i class="bi bi-percent me-1"></i> İndirim Düzenle
                                </button>
                            </div>
                            
                            <div id="paymentDiscountArea" class="p-3 bg-light rounded border d-none">
                                <label class="form-label small fw-bold text-dark">Genel İndirim Tutarı</label>
                                <div class="row g-2">
                                    <div class="col-md-4">
                                        <div class="input-group input-group-sm">
                                            <input type="number" id="paymentGeneralDiscount" class="form-control" placeholder="0.00" step="0.01" min="0">
                                            <span class="input-group-text">₺</span>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <input type="text" id="paymentDiscountNote" class="form-control form-control-sm" placeholder="İndirim Açıklaması">
                                    </div>
                                    <div class="col-md-3 d-flex gap-1">
                                        <button type="button" class="btn btn-sm btn-dark flex-grow-1" id="btnApplyDiscount">Uygula</button>
                                        <button type="button" class="btn btn-sm btn-outline-danger" id="btnRemoveDiscount" onclick="PaymentModule.removeGeneralDiscount()" title="İndirimi Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Ödeme Formu (Sağ Taraf) -->
                    <div class="col-lg-4 p-4 bg-light border-start">
                        <h6 class="fw-bold text-secondary mb-3"><i class="bi bi-credit-card me-2"></i>Ödeme Bilgileri</h6>

                        <!-- Özet Bilgi -->
                        <div id="paymentSummaryAlert" class="alert alert-white shadow-sm border rounded-3 mb-4">
                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                                <span class="small text-muted">Toplam Borç:</span>
                                <span id="summaryTotalDebt" class="fw-bold fs-6">0.00 ₺</span>
                            </div>
                            <!-- Varsa İndirim Gösterimi JS ile buraya eklenebilir veya item listesinde gösteriyoruz zaten -->
                            <div class="d-flex justify-content-between align-items-center mt-2">
                                <span class="small text-dark fw-bold">Kalan Tahsilat:</span>
                                <span id="summaryRemainingDebt" class="fw-bold text-danger fs-4">0.00 ₺</span>
                            </div>
                        </div>

                        <form id="paymentForm">
                            <input type="hidden" id="paymentPatientId" name="patient_id">
                            <input type="hidden" id="paymentAppointmentId" name="appointment_id">
                            

                            <!-- Dinamik Ödeme Satırları -->
                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted mb-2">Ödeme Yöntemi ve Tutar</label>
                                
                                <!-- Kayıtlı (Geçmiş) Ödemeler -->
                                <div id="paymentSavedRowsContainer" class="mb-2"></div>

                                <!-- Yeni Ödeme Satırları -->
                                <div id="paymentRowsContainer">
                                    <!-- JS ile dinamik satırlar eklenecek -->
                                </div>
                                <button type="button" class="btn btn-sm btn-white border w-100 mt-2 text-primary dashed-border" id="btnAddPaymentRow">
                                    <i class="bi bi-plus-circle me-1"></i> Parçalı Ödeme Ekle
                                </button>
                            </div>

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-muted">Açıklama / Not</label>
                                <textarea class="form-control text-sm" name="notes" id="paymentNotes" rows="2" placeholder="Ödeme notu..."></textarea>
                            </div>

                            <div class="d-grid gap-2 mt-5">
                                <button type="submit" class="btn btn-primary btn-lg shadow-sm" id="btnSavePayment">
                                    <i class="bi bi-check-circle me-2"></i>Tahsilatı Kaydet
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btnSaveAndPrintReceipt">
                                    <i class="bi bi-printer me-2"></i>Kaydet ve Yazdır
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.border-dashed {
    border-style: dashed !important;
}
.payment-row {
    animation: slideDown 0.3s ease-out;
}
@keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>
