{# 
    File Manager Component 
    
    Arguments:
        module: string (Required)
        related_id: int (Required)
#}

<div class="card shadow-sm mb-4">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h6 class="mb-0 text-primary"><i class="bi bi-paperclip me-2"></i>Dosyalar</h6>
        <div>
            <label for="file_upload_input_{{ related_id }}" class="btn btn-sm btn-outline-primary" style="cursor: pointer;">
                <i class="bi bi-cloud-upload me-1"></i> Yükle
            </label>
            <input type="file" id="file_upload_input_{{ related_id }}" class="d-none">
        </div>
    </div>
    <div class="card-body p-0" id="file_list_container_{{ related_id }}" style="min-height: 50px;">
        {% if files is defined and files is not empty %}
            <ul class="list-group list-group-flush">
                {% for file in files %}
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            {% if 'image' in file.mime_type %}
                                <i class="bi bi-file-earmark-image fs-4 me-3 text-primary"></i>
                            {% elif 'pdf' in file.mime_type %}
                                <i class="bi bi-file-earmark-pdf fs-4 me-3 text-primary"></i>
                            {% else %}
                                <i class="bi bi-file-earmark fs-4 me-3 text-primary"></i>
                            {% endif %}
                            <div>
                                <a href="/api/files/view/{{ file.uuid }}" target="_blank" class="text-decoration-none fw-bold text-dark">
                                    {{ file.original_name }}
                                </a>
                                <div class="small text-muted">
                                    {{ (file.size_kb / 1024)|number_format(2) }} MB • {{ file.created_at|date('d.m.Y') }}
                                </div>
                            </div>
                        </div>
                        
                        <button class="btn btn-sm btn-outline-danger btn-delete-file" data-uuid="{{ file.uuid }}">
                            <i class="bi bi-trash"></i>
                        </button>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <div class="text-center p-3 text-muted" id="empty_file_list_{{ related_id }}">
                {% if files is defined %}
                    Henüz dosya yüklenmemiş.
                {% else %}
                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                    Yükleniyor...
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>

<script src="/assets/js/file-manager.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        new FileManager({
            module: '{{ module }}',
            relatedId: {{ related_id }},
            containerId: 'file_list_container_{{ related_id }}',
            uploadBtnId: 'file_upload_input_{{ related_id }}',
            csrfToken: '{{ csrf.value }}'
        });
    });
</script>
