{% extends 'layout.twig' %}

{% block head %}
    <link href="{{ base_path }}/assets/css/patients.css?v={{ version }}" rel="stylesheet">
{% endblock %}

{% block page_title %}Hasta Yönetimi{% endblock %}

{% block content %}
    <!-- Statistics (Optional placeholder) -->
    <div class="stats-grid mb-4">
        <div class="stat-card">
            <div class="stat-icon clinics">
                <i class="bi bi-people"></i>
            </div>
            <div class="stat-value" id="totalPatientsCount">{{ stats.total|default(0) }}</div>
            <div class="stat-label">Toplam Hasta</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon active">
                <i class="bi bi-gender-male"></i>
            </div>
            <!-- Note: Complex filtering in Twig is limited without custom extensions, using JS or backend for specific counts is better, but leaving placeholders or simple count -->
            <div class="stat-value" id="malePatientsCount">{{ stats.male|default(0) }}</div>
            <div class="stat-label">Erkek Hasta</div>
        </div>
        <div class="stat-card">
            <div class="stat-icon users">
                <i class="bi bi-gender-female"></i>
            </div>
            <div class="stat-value" id="femalePatientsCount">{{ stats.female|default(0) }}</div>
            <div class="stat-label">Kadın Hasta</div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="table-card">
    <div class="table-card-header d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <h2 class="table-card-title mb-0">
                <i class="bi bi-person-lines-fill me-2"></i>
                Hasta Listesi <small class="text-muted fs-6">(Son 20 Kayıt)</small>
            </h2>

            <div class="d-flex gap-2">
                <div class="input-group w-250">
                    <span class="input-group-text bg-white border-end-0">
                        <i class="bi bi-search text-secondary"></i>
                    </span>
                    <input type="text" id="patientSearch" class="form-control border-start-0"
                        placeholder="İsim veya TC No...">
                </div>
                <a href="{{ base_path }}/admin/patients/add" class="btn-add text-decoration-none">
                    <i class="bi bi-person-plus-fill me-1"></i>
                    Yeni Hasta Ekle
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle" id="patientsTable">
                <thead>
                    <tr>
                        <th>TC Kimlik No</th>
                        <th>Ad Soyad</th>
                        <th>Telefon</th>
                        <th>Cinsiyet</th>
                        <th>Son İşlem</th>
                        <th class="text-end">Aksiyonlar</th>
                    </tr>
                </thead>
                <tbody id="patientsTableBody">
                    {% for patient in patients %}
                    <tr>
                        <td><code>{{ patient.tc_no }}</code></td>
                        <td><div class="fw-bold text-dark">{{ patient.name }}</div></td>
                        <td>{{ patient.phone }}</td>
                        <td>
                            {% if patient.gender == 'M' %}
                                <span class="badge bg-info-subtle text-info rounded-pill">Erkek</span>
                            {% elseif patient.gender == 'F' %}
                                <span class="badge bg-danger-subtle text-danger rounded-pill">Kadın</span>
                            {% else %}
                                <span class="badge bg-secondary-subtle text-secondary rounded-pill">Belirtilmemiş</span>
                            {% endif %}
                        </td>
                        <td>
                            <small class="text-muted">
                                <!-- Simple date formatting, ideal is a Twig extension or filter -->
                                {{ patient.updated_at|default(patient.created_at) }}
                            </small>
                        </td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary" onclick="showPatientDetails({{ patient.id }})" title="Hızlı Önizleme (Modal)">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <a href="{{ base_path }}/admin/patients/{{ patient.id }}" class="btn btn-outline-secondary" title="Tam Detay Sayfası">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                                <a href="{{ base_path }}/admin/patients/{{ patient.id }}/edit" class="btn btn-outline-warning" title="Düzenle">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-outline-danger" onclick="handleArchivePatient({{ patient.id }})" title="Arşivle">
                                    <i class="bi bi-archive"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-person-exclamation fs-1 text-muted"></i>
                            <p class="mt-3 text-secondary">Henüz kayıtlı hasta bulunmuyor.</p>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>



    <!-- Modal 2: Hasta Detay & Vitals -->
    <div class="modal fade" id="detailModal" tabindex="-1" aria-hidden="true">
         <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">
                        <i class="bi bi-file-earmark-medical me-2"></i>
                        Hasta Detayı & Yaşam Bulguları
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="row g-0">
                        <!-- Sol Panel: Hasta Bilgileri -->
                        <div class="col-lg-4 border-end bg-light p-4">
                            <div class="patient-info-card shadow-sm">
                                <div class="text-center mb-4">
                                    <div class="avatar-lg mx-auto mb-3">
                                        <i class="bi bi-person-circle fs-1 text-primary"></i>
                                    </div>
                                    <h4 id="detailName" class="mb-1 text-primary">Yükleniyor...</h4>
                                    <span id="detailGender" class="badge bg-secondary mb-3">...</span>
                                </div>

                                <div class="info-item">
                                    <div class="info-label">TC Kimlik No</div>
                                    <div class="info-value" id="detailTc">...</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Telefon</div>
                                    <div class="info-value" id="detailPhone">...</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Doğum Tarihi / Yaş</div>
                                    <div class="info-value" id="detailBirth">...</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Kan Grubu</div>
                                    <div class="info-value" id="detailBlood">...</div>
                                </div>
                                <div class="info-item">
                                    <div class="info-label">Adres</div>
                                    <div class="info-value small" id="detailAddress">...</div>
                                </div>
                                <div class="info-item mb-0">
                                    <div class="info-label">Notlar</div>
                                    <div class="info-value small mb-0" id="detailNotes">...</div>
                                </div>
                            </div>
                        </div>

                        <!-- Sağ Panel: Sekmeli Yapı -->
                        <div class="col-lg-8">
                            <ul class="nav nav-tabs nav-fill border-0 bg-light" id="patientDetailTabs" role="tablist">
                                {% if permissions.can_view_patient_vitals %}
                                <li class="nav-item">
                                    <button class="nav-link active py-3 border-0 rounded-0 fw-bold" id="vitals-tab" data-bs-toggle="tab" data-bs-target="#vitals-pane" type="button" role="tab">
                                        <i class="bi bi-activity text-danger me-2"></i>Yaşam Bulguları
                                    </button>
                                </li>
                                {% endif %}
                                <li class="nav-item">
                                    <button class="nav-link {{ not permissions.can_view_patient_vitals ? 'active' : '' }} py-3 border-0 rounded-0 fw-bold" id="archive-tab" data-bs-toggle="tab" data-bs-target="#archive-pane" type="button" role="tab">
                                        <i class="bi bi-folder2-open text-primary me-2"></i>Dijital Arşiv
                                    </button>
                                </li>
                            </ul>
 
                            <div class="tab-content">
                                <!-- Tab 1: Vitals -->
                                {% if permissions.can_view_patient_vitals %}
                                <div class="tab-pane fade show active p-4" id="vitals-pane" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h5 class="mb-0 fw-bold">Yaşam Bulguları Geçmişi</h5>
                                        <button class="btn btn-sm btn-outline-danger" id="btnAddVital">
                                            <i class="bi bi-plus-lg me-1"></i>
                                            Yeni Ölçüm Ekle
                                        </button>
                                    </div>

                                    <div class="table-responsive">
                                        <table class="table table-sm vitals-history-table">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Tarih</th>
                                                    <th>Boy (cm)</th>
                                                    <th>Kilo (kg)</th>
                                                    <th>Tansiyon (S/D)</th>
                                                    <th>Nabız (bpm)</th>
                                                    <th>BMI</th>
                                                </tr>
                                            </thead>
                                            <tbody id="vitalsTableBody">
                                                <tr><td colspan="6" class="text-center py-4 text-muted">Yükleniyor...</td></tr>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                                {% endif %}

                                <!-- Tab 2: Digital Archive -->
                                <div class="tab-pane fade {{ not permissions.can_view_patient_vitals ? 'show active' : '' }} p-4" id="archive-pane" role="tabpanel">
                                    <div class="d-flex justify-content-between align-items-center mb-4">
                                        <h5 class="mb-0 fw-bold">Hasta Dosyaları & Ekler</h5>
                                        <div>
                                            <label for="patient_file_upload" class="btn btn-sm btn-outline-primary" style="cursor: pointer;">
                                                <i class="bi bi-cloud-upload me-1"></i> Yeni Dosya Yükle
                                            </label>
                                            <input type="file" id="patient_file_upload" class="d-none">
                                        </div>
                                    </div>
                                    <div id="patient_file_list" class="border rounded bg-light" style="min-height: 200px;">
                                        <div class="text-center p-5 text-muted">
                                            <div class="spinner-border spinner-border-sm me-2"></div> Dosyalar yükleniyor...
                                        </div>
                                    </div>
                                    <div class="mt-3 small text-muted">
                                        <i class="bi bi-info-circle me-1"></i> Bu listede hastaya ait genel dosyalar ve tüm muayene ekleri kronolojik olarak gösterilir.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        /**
         * Pozitif Klinik - Hasta Yönetimi Scripts
         */

        // Token & Yetki Kontrolü
        const token = localStorage.getItem('platform_token');
        const userType = localStorage.getItem('user_type');

        // Global State
        let detailModal;
        let patientFileManager;

        // DOM Elements
        let patientsTableBody;
        let patientSearch;

        // Detail Modal Elements
        let vitalsTableBody;
        let btnAddVital;

        // Sayfa Yüklendiğinde
        document.addEventListener('DOMContentLoaded', () => {
            detailModal = new bootstrap.Modal(document.getElementById('detailModal'));

            patientsTableBody = document.getElementById('patientsTableBody');
            patientSearch = document.getElementById('patientSearch');
            vitalsTableBody = document.getElementById('vitalsTableBody');
            btnAddVital = document.getElementById('btnAddVital');

            setupEventListeners();
        });

        // Event Listeners
        function setupEventListeners() {
            // Sunucu Taraflı Arama (Blind Search Entegrasyonu)
            let searchTimeout = null;
            
            patientSearch.addEventListener('input', (e) => {
                const query = e.target.value.toLowerCase().trim();

                clearTimeout(searchTimeout);

                if (query.length < 2) {
                    if (query.length === 0) {
                         window.location.reload(); 
                    }
                    return;
                }

                // Debounce: Yazma bittikten 500ms sonra ara
                searchTimeout = setTimeout(async () => {
                    try {
                        // Tabloyu yükleniyor moduna al
                        patientsTableBody.innerHTML = `
                            <tr>
                                <td colspan="6" class="text-center py-5">
                                    <div class="spinner-border text-primary" role="status"></div>
                                    <p class="mt-2 text-muted">Aranıyor...</p>
                                </td>
                            </tr>
                        `;

                        const response = await api.get(`/api/patients/search?q=${encodeURIComponent(query)}`);
                        const results = response.data || [];

                        renderPatientTable(results);

                    } catch (error) {
                        console.error('Arama hatası:', error);
                        patientsTableBody.innerHTML = `
                            <tr>
                                <td colspan="6" class="text-center py-5 text-danger">
                                    <i class="bi bi-exclamation-circle fs-1"></i>
                                    <p class="mt-2">Arama sırasında bir hata oluştu.</p>
                                </td>
                            </tr>
                        `;
                    }
                }, 500); 
            });
        }

        /**
         * Tabloyu Dinamik Olarak Yenile
         */
        function renderPatientTable(patients) {
            patientsTableBody.innerHTML = '';

            if (patients.length === 0) {
                patientsTableBody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <i class="bi bi-search fs-1 text-muted opacity-50"></i>
                            <p class="mt-3 text-secondary">Sonuç bulunamadı.</p>
                        </td>
                    </tr>
                `;
                return;
            }

            patients.forEach(patient => {
                const tr = document.createElement('tr');
                
                // Cinsiyet Badge
                let genderHtml = '<span class="badge bg-secondary-subtle text-secondary rounded-pill">Belirtilmemiş</span>';
                if (patient.gender === 'M') {
                    genderHtml = '<span class="badge bg-info-subtle text-info rounded-pill">Erkek</span>';
                } else if (patient.gender === 'F') {
                    genderHtml = '<span class="badge bg-danger-subtle text-danger rounded-pill">Kadın</span>';
                }

                // Tarih (updated_at veya created_at)
                const lastActionDate = patient.updated_at || patient.created_at;

                // Base path construction logic check:
                // If not available in JS context, we can infer from current location or use a relative path
                // Since this is admin panel, /admin/patients/... is safe.
                const basePath = window.location.origin + '/admin';

                tr.innerHTML = `
                    <td><code>${patient.tc_no || '-'}</code></td>
                    <td><div class="fw-bold text-dark">${patient.name}</div></td>
                    <td>${patient.phone || '-'}</td>
                    <td>${genderHtml}</td>
                    <td><small class="text-muted">${lastActionDate || '-'}</small></td>
                    <td class="text-end">
                        <div class="btn-group btn-group-sm">
                            <button class="btn btn-outline-primary" onclick="showPatientDetails(${patient.id})" title="Hızlı Önizleme (Modal)">
                                <i class="bi bi-eye"></i>
                            </button>
                            <a href="${basePath}/patients/${patient.id}" class="btn btn-outline-secondary" title="Tam Detay Sayfası">
                                <i class="bi bi-box-arrow-up-right"></i>
                            </a>
                            <a href="${basePath}/patients/${patient.id}/edit" class="btn btn-outline-warning" title="Düzenle">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-outline-danger" onclick="handleArchivePatient(${patient.id})" title="Arşivle">
                                <i class="bi bi-archive"></i>
                            </button>
                        </div>
                    </td>
                `;
                patientsTableBody.appendChild(tr);
            });
        }



        // Hasta Detay & Vitals Göster
        window.showPatientDetails = async function (id) {
            Utils.showLoading('Hasta detayları getiriliyor...');
            try {
                const response = await api.get(`/api/patients/${id}`);
                const patient = response.data;

                // Sol Panel (Bio)
                document.getElementById('detailName').textContent = patient.name;
                document.getElementById('detailTc').textContent = patient.tc_no;
                document.getElementById('detailPhone').textContent = patient.phone;
                document.getElementById('detailBirth').textContent = patient.birth_date || '-';
                document.getElementById('detailBlood').textContent = patient.blood_type || '-';

                const fullAddress = [
                    patient.address,
                    patient.district_name,
                    patient.province_name
                ].filter(Boolean).join(', ');

                document.getElementById('detailAddress').textContent = fullAddress || 'Adres bilgisi yok.';
                document.getElementById('detailNotes').textContent = patient.notes || 'Not bulunmuyor.';

                const genderMap = { 'M': 'Erkek', 'F': 'Kadın', 'U': 'Bilinmiyor' };
                document.getElementById('detailGender').textContent = genderMap[patient.gender] || 'Bilinmiyor';

                // Sağ Panel (Vitals)
                renderVitalsTable(patient.vitals_history || []);

                // Tabları sıfırla (İlk sekmeyi aç)
                const firstTabEl = document.querySelector('#vitals-tab');
                const firstTab = new bootstrap.Tab(firstTabEl);
                firstTab.show();

                // Dijital Arşiv (FileManager) Başlat
                patientFileManager = new FileManager({
                    module: 'patient',
                    relatedId: patient.id,
                    containerId: 'patient_file_list',
                    uploadBtnId: 'patient_file_upload',
                    csrfToken: '{{ csrf.value }}',
                    customListUrl: `/api/files/search?patient_id=${patient.id}`
                });

                // Add Vital Button'ı ID ile bağla
                btnAddVital.onclick = () => handleAddVital(patient.id);

                Utils.closeLoading();
                detailModal.show();
            } catch (error) {
                Utils.closeLoading();
                Utils.showError('Hasta detayı yüklenemedi.');
            }
        };

        // Vitals Tablosunu Render Et
        function renderVitalsTable(history) {
            vitalsTableBody.innerHTML = '';

            if (history.length === 0) {
                vitalsTableBody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-muted">Ölçüm kaydı bulunamadı.</td></tr>';
                return;
            }

            history.forEach(v => {
                const bmi = (v.weight && v.height) ? (v.weight / ((v.height / 100) * (v.height / 100))).toFixed(1) : '-';
                const row = document.createElement('tr');

                const tdDate = document.createElement('td');
                tdDate.textContent = Utils.formatDate(v.measured_at);
                row.appendChild(tdDate);

                const tdHeight = document.createElement('td');
                tdHeight.textContent = v.height || '-';
                row.appendChild(tdHeight);

                const tdWeight = document.createElement('td');
                tdWeight.textContent = v.weight || '-';
                row.appendChild(tdWeight);

                const tdBp = document.createElement('td');
                tdBp.textContent = `${v.systolic_bp || '-'}/${v.diastolic_bp || '-'}`;
                row.appendChild(tdBp);

                const tdHr = document.createElement('td');
                tdHr.textContent = v.heart_rate || '-';
                row.appendChild(tdHr);

                const tdBmi = document.createElement('td');
                const bmiBadge = document.createElement('span');
                bmiBadge.className = 'badge bg-secondary';
                bmiBadge.textContent = bmi;
                tdBmi.appendChild(bmiBadge);
                row.appendChild(tdBmi);

                vitalsTableBody.appendChild(row);
            });
        }

        // Yaşam Bulgusu Ekle (SweetAlert2 ile)
        async function handleAddVital(patientId) {
            const { value: formValues } = await Swal.fire({
                target: document.getElementById('detailModal'),
                title: 'Yaşam Bulgusu Ekle',
                html:
                    '<div class="row g-3 text-start">' +
                    '  <div class="col-12"><label class="small fw-bold text-primary">Ölçüm Zamanı</label><input id="swal-date" type="datetime-local" class="form-control" value="' + new Date().toLocaleString('sv-SE').slice(0, 16).replace(' ', 'T') + '"></div>' +
                    '  <div class="col-6"><label class="small fw-bold">Boy (cm)</label><input id="swal-height" type="number" class="form-control" placeholder="175"></div>' +
                    '  <div class="col-6"><label class="small fw-bold">Kilo (kg)</label><input id="swal-weight" type="number" step="0.1" class="form-control" placeholder="70.5"></div>' +
                    '  <div class="col-6"><label class="small fw-bold">Tansiyon (Büyük)</label><input id="swal-sys" type="number" class="form-control" placeholder="120"></div>' +
                    '  <div class="col-6"><label class="small fw-bold">Tansiyon (Küçük)</label><input id="swal-dia" type="number" class="form-control" placeholder="80"></div>' +
                    '  <div class="col-12"><label class="small fw-bold">Nabız (bpm)</label><input id="swal-hr" type="number" class="form-control" placeholder="72"></div>' +
                    '</div>',
                focusConfirm: false,
                showCancelButton: true,
                confirmButtonText: 'Kaydet',
                cancelButtonText: 'İptal',
                didOpen: () => {
                    const firstInput = document.getElementById('swal-height');
                    if (firstInput) firstInput.focus();
                },
                preConfirm: () => {
                    return {
                        measured_at: document.getElementById('swal-date').value,
                        height: document.getElementById('swal-height').value,
                        weight: document.getElementById('swal-weight').value,
                        systolic_bp: document.getElementById('swal-sys').value,
                        diastolic_bp: document.getElementById('swal-dia').value,
                        heart_rate: document.getElementById('swal-hr').value
                    }
                }
            });

            if (formValues) {
                try {
                    Utils.showLoading('Kaydediliyor...');
                    const response = await api.post(`/api/patients/${patientId}/vitals`, formValues);
                    const detailRes = await api.get(`/api/patients/${patientId}`);
                    renderVitalsTable(detailRes.data.vitals_history || []);
                    Utils.closeLoading();
                    Utils.showSuccess('Ölçüm başarıyla kaydedildi.');
                } catch (error) {
                    Utils.closeLoading();
                    Utils.showError(typeof error === 'string' ? error : 'Ölçüm kaydedilemedi.');
                }
            }
        }

        // Hastayı Arşivle
        window.handleArchivePatient = async function (id) {
            const result = await Swal.fire({
                title: 'Emin misiniz?',
                text: "Hata kaydı arşive taşınacak.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Evet, Arşivle',
                cancelButtonText: 'Vazgeç'
            });

            if (result.isConfirmed) {
                try {
                    await api.patch(`/api/patients/${id}/archive`);
                    Utils.showSuccess('Hasta arşivlendi.');
                    window.location.reload();
                } catch (error) {
                    Utils.showError('Arşivleme işlemi başarısız.');
                }
            }
        };



        /**
         * TC Kimlik Numarası Doğrulayıcı
         */
        function validateTCKN(tckn) {
            if (!tckn || tckn.length !== 11 || isNaN(tckn)) return false;
            if (tckn === "11111111111") return true;
            const digits = tckn.split('').map(Number);
            if (digits[0] === 0) return false;
            const oddSum = digits[0] + digits[2] + digits[4] + digits[6] + digits[8];
            const evenSum = digits[1] + digits[3] + digits[5] + digits[7];
            let tenthDigit = ((oddSum * 7) - evenSum) % 10;
            if (tenthDigit < 0) tenthDigit += 10;
            if (tenthDigit !== digits[9]) return false;
            const totalSum = digits.slice(0, 10).reduce((acc, curr) => acc + curr, 0);
            const eleventhDigit = totalSum % 10;
            if (eleventhDigit !== digits[10]) return false;
            return true;
        }
    </script>
    <script src="{{ base_path }}/assets/js/file-manager.js?v={{ version }}"></script>
{% endblock %}
