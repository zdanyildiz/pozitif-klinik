<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pozitif Klinik Platform Yönetim Paneli - Dashboard">
    <title>Dashboard | Pozitif Klinik Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="{{ base_path }}/assets/css/dashboard.css?v={{ version }}" rel="stylesheet">
</head>

<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="#" class="sidebar-logo">
                <div class="sidebar-logo-icon">
                    <i class="bi bi-hospital"></i>
                </div>
                <div class="sidebar-logo-text">
                    Pozitif
                    <span>Platform Yönetimi</span>
                </div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">Ana Menü</div>
                <a href="{{ base_path }}/platform/dashboard" class="nav-link-custom active">
                    <i class="bi bi-building"></i>
                    Klinikler
                </a>
                <a href="#" class="nav-link-custom">
                    <i class="bi bi-people"></i>
                    Kullanıcılar
                </a>
                <a href="#" class="nav-link-custom">
                    <i class="bi bi-bar-chart"></i>
                    İstatistikler
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-section-title">Sistem</div>
                <a href="#" class="nav-link-custom">
                    <i class="bi bi-gear"></i>
                    Ayarlar
                </a>
                <a href="{{ base_path }}/platform/logs" class="nav-link-custom">
                    <i class="bi bi-file-text"></i>
                    Loglar
                </a>
            </div>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Top Navbar -->
        <header class="top-navbar">
            <h1 class="navbar-title">Klinik Yönetimi</h1>

            <div class="navbar-actions">
                <button class="btn-logout" id="logoutBtn">
                    <i class="bi bi-box-arrow-right"></i>
                    Çıkış Yap
                </button>
            </div>
        </header>

        <!-- Content Area -->
        <div class="content-area">
            <!-- Stats Grid -->
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon clinics">
                        <i class="bi bi-building"></i>
                    </div>
                    <div class="stat-value" id="totalClinics">0</div>
                    <div class="stat-label">Toplam Klinik</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon active">
                        <i class="bi bi-check-circle"></i>
                    </div>
                    <div class="stat-value" id="activeClinics">0</div>
                    <div class="stat-label">Aktif Klinik</div>
                </div>

                <div class="stat-card">
                    <div class="stat-icon users">
                        <i class="bi bi-people"></i>
                    </div>
                    <div class="stat-value" id="totalUsers">-</div>
                    <div class="stat-label">Toplam Kullanıcı</div>
                </div>
            </div>

            <!-- Tenants Table -->
            <div class="table-card">
                <div class="table-card-header">
                    <h2 class="table-card-title">
                        <i class="bi bi-list-ul"></i>
                        Klinik Listesi
                    </h2>
                    <button class="btn-add" data-bs-toggle="modal" data-bs-target="#newTenantModal">
                        <i class="bi bi-plus-lg"></i>
                        Yeni Klinik Ekle
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table" id="tenantsTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Klinik Adı</th>
                                <th>Domain Prefix</th>
                                <th>Durum</th>
                                <th>Oluşturulma Tarihi</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="tenantsTableBody">
                            <tr id="loadingRow">
                                <td colspan="6">
                                    <div class="loading-state">
                                        <div class="loading-spinner"></div>
                                        <p>Klinikler yükleniyor...</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- New Tenant Modal -->
    <div class="modal fade" id="newTenantModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-building-add me-2"></i>
                        Yeni Klinik Oluştur
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form id="newTenantForm">
                        <div class="mb-3">
                            <label class="form-label">Klinik Adı</label>
                            <input type="text" class="form-control" name="name" id="clinicName" placeholder="Örn: Pozitif Diş Polikliniği" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Domain Prefix</label>
                            <input type="text" class="form-control" name="domain_prefix" id="domainPrefix" placeholder="pozitifdis" required>
                        </div>
                        <div class="section-divider">
                            <span><i class="bi bi-person-badge me-1"></i>Yönetici Bilgileri</span>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yönetici Kullanıcı Adı</label>
                            <input type="text" class="form-control" name="admin_username" id="adminUsername" placeholder="admin" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yönetici Şifresi</label>
                            <input type="password" class="form-control" name="admin_password" id="adminPassword" placeholder="••••••••" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-save" id="saveTenantBtn">Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Tenant Modal -->
    <div class="modal fade" id="editTenantModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <!-- Content same as legacy dashboard but updated for Twig if needed -->
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-pencil-square me-2"></i>Klinik Düzenle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form id="editTenantForm">
                        <div class="mb-3">
                            <label class="form-label">Klinik Adı</label>
                            <input type="text" class="form-control" id="editClinicName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Domain Prefix</label>
                            <input type="text" class="form-control" id="editClinicDomain" readonly disabled>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Durum</label>
                            <select class="form-select" id="editClinicStatus">
                                <option value="1">Aktif</option>
                                <option value="0">Pasif</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yönetici Kullanıcı Adı</label>
                            <input type="text" class="form-control" id="editAdminUsername" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yeni Şifre</label>
                            <input type="password" class="form-control" id="editAdminPassword" placeholder="Değiştirmek istemiyorsanız boş bırakın">
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-save" id="updateTenantBtn">Güncelle</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.2/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom JS -->
    <script src="{{ base_path }}/assets/js/config.js?v={{ version }}"></script>
    <script src="{{ base_path }}/assets/js/dashboard.js?v={{ version }}"></script>
</body>
</html>
