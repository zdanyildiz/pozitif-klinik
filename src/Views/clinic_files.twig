{% extends 'layout.twig' %}

{% block page_title %}Dijital Arşiv{% endblock %}

{% block content %}
<div class="container-fluid">
    {# Modül Kartları #}
    <div class="row g-3 mb-4">
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm module-card cursor-pointer" onclick="filterByModule('patient')">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-1">Hasta Dosyaları</h6>
                        <h3 class="fw-bold text-dark mb-0 counter">{{ stats.patient }}</h3>
                    </div>
                    <div class="icon-shape bg-primary bg-opacity-10 text-primary rounded-3">
                        <i class="bi bi-person-vcard fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm module-card cursor-pointer" onclick="filterByModule('examination')">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-1">Muayene Ekleri</h6>
                        <h3 class="fw-bold text-dark mb-0 counter">{{ stats.examination }}</h3>
                    </div>
                    <div class="icon-shape bg-success bg-opacity-10 text-success rounded-3">
                        <i class="bi bi-file-medical fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm module-card cursor-pointer" onclick="filterByModule('lab')">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-1">Laboratuvar</h6>
                        <h3 class="fw-bold text-dark mb-0 counter">{{ stats.lab }}</h3>
                    </div>
                    <div class="icon-shape bg-danger bg-opacity-10 text-danger rounded-3">
                        <i class="bi bi-clipboard-pulse fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-12 col-md-6 col-lg-3">
            <div class="card h-100 border-0 shadow-sm module-card cursor-pointer" onclick="filterByModule('')">
                <div class="card-body p-4 d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-muted text-uppercase small fw-bold mb-1">Tüm Arşiv</h6>
                        <h3 class="fw-bold text-dark mb-0 counter">{{ stats.total }}</h3>
                    </div>
                    <div class="icon-shape bg-secondary bg-opacity-10 text-secondary rounded-3">
                        <i class="bi bi-folder2-open fs-4"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Arama ve Filtreleme #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-md-5">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Arama</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-secondary"></i></span>
                        <input type="text" id="searchInput" class="form-control border-start-0 ps-0 bg-light" 
                               placeholder="Hasta Adı, TC Kimlik veya Telefon..." autocomplete="off">
                    </div>
                </div>
                <!-- Gizli Modül Filtresi -->
                <input type="hidden" id="moduleFilter">

                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Dosya Türü</label>
                    <select id="typeFilter" class="form-select bg-light border-0">
                        <option value="">Tüm Türler</option>
                        <option value="image">Resimler (JPEG/PNG)</option>
                        <option value="pdf">PDF Dokümanları</option>
                        <option value="document">Word/Excel Belgeleri</option>
                    </select>
                </div>
                
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Kategori</label>
                    <div class="d-flex gap-2">
                        <input type="radio" class="btn-check" name="category" id="cat_all" value="" checked>
                        <label class="btn btn-outline-secondary btn-sm rounded-pill px-3" for="cat_all">Tümü</label>

                        <input type="radio" class="btn-check" name="category" id="cat_report" value="report">
                        <label class="btn btn-outline-secondary btn-sm rounded-pill px-3" for="cat_report">Rapor</label>

                        <input type="radio" class="btn-check" name="category" id="cat_prescription" value="prescription">
                        <label class="btn btn-outline-secondary btn-sm rounded-pill px-3" for="cat_prescription">Reçete</label>
                        
                        <input type="radio" class="btn-check" name="category" id="cat_other" value="other">
                        <label class="btn btn-outline-secondary btn-sm rounded-pill px-3" for="cat_other">Diğer</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Dosya Listesi #}
    <div class="card border-0 shadow-sm" style="min-height: 400px;">
        <div class="card-header bg-white py-3 border-bottom-0 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 card-title fw-bold text-primary">
                <i class="bi bi-files me-2"></i>Dosyalar
            </h5>
            <div id="loadingIndicator" class="spinner-border text-primary spinner-border-sm d-none" role="status">
                <span class="visually-hidden">Yükleniyor...</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                <thead class="bg-light text-uppercase small fw-bold text-muted">
                    <tr>
                        <th class="ps-4" style="width: 60px;">Tür</th>
                        <th>Dosya Adı</th>
                        <th>İlgili Hasta</th>
                        <th>Kaynak / Kategori</th>
                        <th>Boyut</th>
                        <th>Tarih</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="fileListBody" class="border-top-0">
                    {# JS ile doldurulacak #}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted opacity-50">
                                <i class="bi bi-hand-index-thumb fs-1"></i>
                                <p class="mt-3 fs-5 mb-0">Listelemek için bir modül seçin veya arama yapın.</p>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
.cursor-pointer { cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; }
.cursor-pointer:hover { transform: translateY(-3px); box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important; }
.module-card.active { border: 2px solid var(--bs-primary) !important; background-color: var(--bs-primary-bg-subtle); }
.ls-1 { letter-spacing: 0.5px; }
.avatar-xs { width: 2rem; height: 2rem; }
.icon-shape { width: 3rem; height: 3rem; display: flex; align-items: center; justify-content: center; }
.hover-lift { transition: transform 0.2s; }
.hover-lift:hover { transform: translateY(-2px); }
</style>

<script>
    let searchTimeout;
    
    // UI Elements
    const searchInput = document.getElementById('searchInput');
    const typeFilter = document.getElementById('typeFilter');
    const moduleFilter = document.getElementById('moduleFilter');
    const categoryRadios = document.querySelectorAll('input[name="category"]');
    const fileListBody = document.getElementById('fileListBody');
    const loadingIndicator = document.getElementById('loadingIndicator');
    const moduleCards = document.querySelectorAll('.module-card');

    function filterByModule(moduleName) {
        moduleFilter.value = moduleName;
        
        // Visual feedback
        moduleCards.forEach(card => card.classList.remove('active'));
        if (event && event.currentTarget) {
            event.currentTarget.classList.add('active');
        }

        fetchFiles();
    }

    function getSelectedCategory() {
        for (const radio of categoryRadios) {
            if (radio.checked) return radio.value;
        }
        return '';
    }

    function fetchFiles() {
        // Show loading
        loadingIndicator.classList.remove('d-none');
        fileListBody.style.opacity = '0.5';

        const params = new URLSearchParams({
            q: searchInput.value,
            module: moduleFilter.value,
            type: typeFilter.value,
            file_category: getSelectedCategory(),
            limit: 50 // Limit results
        });

        fetch(`/api/files/search?${params.toString()}`)
            .then(res => res.json())
            .then(data => {
                renderFiles(data.data || data); // Handle standard API response wrapper if exists
            })
            .catch(err => {
                console.error('Hata:', err);
                fileListBody.innerHTML = `<tr><td colspan="7" class="text-center text-danger py-4">Veri yüklenirken hata oluştu.</td></tr>`;
            })
            .finally(() => {
                loadingIndicator.classList.add('d-none');
                fileListBody.style.opacity = '1';
            });
    }

    function renderFiles(files) {
        if (!files || files.length === 0) {
            fileListBody.innerHTML = `
                <tr>
                    <td colspan="7" class="text-center py-5">
                        <div class="text-muted opacity-50">
                            <i class="bi bi-folder-x fs-1"></i>
                            <p class="mt-3 fs-5 mb-0">Dosya bulunamadı.</p>
                        </div>
                    </td>
                </tr>`;
            return;
        }

        fileListBody.innerHTML = files.map(file => {
            let icon = 'bi-file-earmark-text-fill';
            let colorClass = 'bg-secondary-subtle text-secondary';
            
            if (file.mime_type.includes('image')) {
                icon = 'bi-file-earmark-image-fill';
                colorClass = 'bg-warning-subtle text-warning';
            } else if (file.mime_type.includes('pdf')) {
                icon = 'bi-file-earmark-pdf-fill';
                colorClass = 'bg-danger-subtle text-danger';
            } else if (file.mime_type.includes('word') || file.mime_type.includes('officedocument')) {
                icon = 'bi-file-earmark-word-fill';
                colorClass = 'bg-primary-subtle text-primary';
            } else if (file.mime_type.includes('excel') || file.mime_type.includes('spreadsheet') || file.mime_type.includes('csv')) {
                icon = 'bi-file-earmark-excel-fill';
                colorClass = 'bg-success-subtle text-success';
            }

            // Kategori Badge
            let categoryBadge = '';
            if (file.file_category === 'prescription') categoryBadge = '<span class="badge bg-purple-subtle text-purple border border-purple-subtle ms-1">Reçete</span>';
            else if (file.file_category === 'report') categoryBadge = '<span class="badge bg-indigo-subtle text-indigo border border-indigo-subtle ms-1">Rapor</span>';

            // Module Badge
            let moduleBadge = '';
            if (file.module === 'patient') moduleBadge = '<span class="badge bg-info-subtle text-info">Hasta Dosyası</span>';
            else if (file.module === 'examination') moduleBadge = '<span class="badge bg-success-subtle text-success">Muayene</span>';
            else if (file.module === 'lab') moduleBadge = '<span class="badge bg-danger-subtle text-danger">Laboratuvar</span>';
            else moduleBadge = `<span class="badge bg-secondary-subtle text-secondary">${file.module}</span>`;

            return `
                <tr>
                    <td class="ps-4 text-center">
                        <div class="icon-shape align-middle d-inline-flex icon-sm ${colorClass} rounded-3 bg-opacity-50" style="width:2.5rem; height:2.5rem;">
                            <i class="bi ${icon} fs-5"></i>
                        </div>
                    </td>
                    <td>
                        <div class="fw-semibold text-dark">${file.original_name}</div>
                        <small class="text-muted" style="font-size: 0.75rem;">${file.display_name || ''}</small>
                    </td>
                    <td>
                        ${file.patient_name ? `
                            <div class="d-flex align-items-center">
                                <div class="avatar-xs me-2 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width:24px; height:24px; font-size:10px;">
                                    ${file.patient_name.charAt(0).toUpperCase()}
                                </div>
                                <span class="fw-medium text-dark">${file.patient_name}</span>
                            </div>
                        ` : '<span class="text-muted">-</span>'}
                    </td>
                    <td>
                        <div class="d-flex flex-column gap-1">
                            <div>${moduleBadge}</div>
                            ${categoryBadge ? `<div>${categoryBadge}</div>` : ''}
                        </div>
                    </td>
                    <td class="text-muted">${file.size_kb} KB</td>
                    <td class="text-muted">
                        ${new Date(file.created_at).toLocaleDateString('tr-TR')} 
                        <small class="d-block text-secondary">${new Date(file.created_at).toLocaleTimeString('tr-TR', {hour: '2-digit', minute:'2-digit'})}</small>
                    </td>
                    <td class="text-end pe-4">
                        <a href="/api/files/view/${file.uuid}" target="_blank" class="btn btn-sm btn-light text-primary border shadow-sm hover-lift">
                            <i class="bi bi-download"></i>
                        </a>
                        <button class="btn btn-sm btn-light text-danger border shadow-sm ms-1 hover-lift" onclick="deleteFile('${file.uuid}')">
                           <i class="bi bi-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    // Event Listeners for Instant Filtering
    searchInput.addEventListener('keyup', () => {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(fetchFiles, 300);
    });

    typeFilter.addEventListener('change', fetchFiles);
    
    categoryRadios.forEach(radio => {
        radio.addEventListener('change', fetchFiles);
    });

    // Delete Func (Simple implementation)
    async function deleteFile(uuid) {
        const isConfirmed = await Utils.showConfirm('Silme Onayı', 'Bu dosyayı silmek istediğinize emin misiniz?');
        if(!isConfirmed) return;
        
        try {
            const res = await api.delete('/api/files/' + uuid);
            if(res.status) {
                Utils.showToast('Dosya silindi.');
                fetchFiles(); // Refresh
            }
        } catch (err) {
            Utils.showError(typeof err === 'string' ? err : 'Dosya silinirken bir hata oluştu.');
        }
    }

    // Initial load? No, wait for interaction as requested. 
    // "girer girmez dosyalar sıralanmasın. modül kartları olsun, tıklanınca modül kartlarındaki dosyalar listelensin."
    // So we don't call fetchFiles() initially.
</script>
{% endblock %}
