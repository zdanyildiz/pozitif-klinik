{% extends 'layout.twig' %}

{% block page_title %}Dijital Arşiv{% endblock %}

{% block content %}
<div class="container-fluid">
    {# Filtreleme Alanı #}
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body p-4">
            <form method="GET" action="/admin/files" class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Hasta Adı</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-secondary"></i></span>
                        <input type="text" name="q" class="form-control border-start-0 ps-0 bg-light" placeholder="Hasta adı ile ara..." value="{{ filters.q }}">
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Modül</label>
                    <select name="module" class="form-select bg-light border-0">
                        <option value="">Tüm Modüller</option>
                        <option value="patient" {{ filters.module == 'patient' ? 'selected' : '' }}>Hasta Dosyaları</option>
                        <option value="examination" {{ filters.module == 'examination' ? 'selected' : '' }}>Muayene Ekleri</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small fw-bold text-muted text-uppercase ls-1">Dosya Türü</label>
                    <select name="type" class="form-select bg-light border-0">
                        <option value="">Tüm Türler</option>
                        <option value="image" {{ filters.type == 'image' ? 'selected' : '' }}>Resimler (JPEG/PNG)</option>
                        <option value="pdf" {{ filters.type == 'pdf' ? 'selected' : '' }}>PDF Dokümanları</option>
                        <option value="document" {{ filters.type == 'document' ? 'selected' : '' }}>Word/Excel</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100 fw-medium">
                        <i class="bi bi-filter me-1"></i> Filtrele
                    </button>
                </div>
            </form>
        </div>
    </div>

    {# Dosya Listesi #}
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white py-3 border-bottom-0">
            <div class="d-flex align-items-center justify-content-between">
                <h5 class="mb-0 card-title fw-bold text-primary">
                    <i class="bi bi-folder2-open me-2"></i>Dosya Arşivi
                </h5>
                <span class="badge bg-light text-secondary rounded-pill px-3">{{ files|length }} Dosya</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.95rem;">
                <thead class="bg-light text-uppercase small fw-bold text-muted">
                    <tr>
                        <th class="ps-4" style="width: 60px;">Tür</th>
                        <th>Dosya Adı</th>
                        <th>İlgili Hasta</th>
                        <th>Kaynak Modül</th>
                        <th>Boyut</th>
                        <th>Yüklenme Tarihi</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody class="border-top-0">
                    {% for file in files %}
                        <tr>
                            <td class="ps-4 text-center">
                                {% if 'image' in file.mime_type %}
                                    <div class="icon-shape icon-sm bg-warning-subtle text-warning rounded-3 bg-opacity-50">
                                        <i class="bi bi-file-earmark-image-fill fs-5"></i>
                                    </div>
                                {% elseif 'pdf' in file.mime_type %}
                                    <div class="icon-shape icon-sm bg-danger-subtle text-danger rounded-3 bg-opacity-50">
                                        <i class="bi bi-file-earmark-pdf-fill fs-5"></i>
                                    </div>
                                {% else %}
                                    <div class="icon-shape icon-sm bg-secondary-subtle text-secondary rounded-3 bg-opacity-50">
                                        <i class="bi bi-file-earmark-text-fill fs-5"></i>
                                    </div>
                                {% endif %}
                            </td>
                            <td>
                                <div class="fw-semibold text-dark">{{ file.original_name }}</div>
                                <small class="text-muted" style="font-size: 0.75rem;">{{ file.mime_type }}</small>
                            </td>
                            <td>
                                {% if file.patient_name %}
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-xs me-2 rounded-circle bg-primary-subtle text-primary d-flex align-items-center justify-content-center fw-bold" style="width:28px; height:28px; font-size:11px;">
                                            {{ file.patient_name|slice(0,1)|upper }}
                                        </div>
                                        <span class="fw-medium text-dark">{{ file.patient_name }}</span>
                                    </div>
                                {% else %}
                                    <span class="text-muted fst-italic">-</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if file.module == 'patient' %}
                                    <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-1">Hasta Dosyası</span>
                                {% elseif file.module == 'examination' %}
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">Muayene Eki</span>
                                {% else %}
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle px-2 py-1">{{ file.module }}</span>
                                {% endif %}
                            </td>
                            <td class="text-muted">{{ file.size_kb }} KB</td>
                            <td class="text-muted">
                                <i class="bi bi-clock me-1 text-secondary"></i>
                                {{ file.created_at|date("d.m.Y H:i") }}
                            </td>
                            <td class="text-end pe-4">
                                <a href="/api/files/view/{{ file.uuid }}" target="_blank" class="btn btn-sm btn-light text-primary border shadow-sm" title="İndir / Görüntüle">
                                    <i class="bi bi-download"></i> <span class="d-none d-md-inline ms-1">İndir</span>
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center py-5">
                                <div class="text-muted opacity-50">
                                    <i class="bi bi-folder2-open fs-1"></i>
                                    <p class="mt-3 fs-5 mb-0">Aradığınız kriterlere uygun dosya bulunamadı.</p>
                                    <small>Filtreleri değiştirerek tekrar deneyiniz.</small>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
    </div>
</div>

<style>
/* Custom Styles for File Manager */
.ls-1 { letter-spacing: 0.5px; }
.avatar-xs { width: 2rem; height: 2rem; }
.icon-shape {
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>
{% endblock %}
