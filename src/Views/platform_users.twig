<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pozitif Klinik Platform Yönetim Paneli - Platform Yöneticileri">
    <title>Platform Yöneticileri | Pozitif Klinik Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="{{ base_path }}/assets/css/dashboard.css?v={{ version }}" rel="stylesheet">
</head>

<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="{{ base_path }}/platform/dashboard" class="sidebar-logo">
                <div class="sidebar-logo-icon">
                    <i class="bi bi-hospital"></i>
                </div>
                <div class="sidebar-logo-text">
                    Pozitif
                    <span>Platform Yönetimi</span>
                </div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">Ana Menü</div>
                <a href="{{ base_path }}/platform/dashboard" class="nav-link-custom">
                    <i class="bi bi-building"></i>
                    Klinikler
                </a>
                <a href="{{ base_path }}/platform/users" class="nav-link-custom active">
                    <i class="bi bi-people"></i>
                    Kullanıcılar
                </a>
                <a href="#" class="nav-link-custom">
                    <i class="bi bi-bar-chart"></i>
                    İstatistikler
                </a>
            </div>

            <div class="nav-section">
                <div class="nav-section-title">Sistem</div>
                <a href="#" class="nav-link-custom">
                    <i class="bi bi-gear"></i>
                    Ayarlar
                </a>
                <a href="{{ base_path }}/platform/logs" class="nav-link-custom">
                    <i class="bi bi-file-text"></i>
                    Loglar
                </a>
            </div>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <!-- Top Navbar -->
        <header class="top-navbar">
            <h1 class="navbar-title">Platform Yöneticileri</h1>

            <div class="navbar-actions">
                <button class="btn-logout" id="logoutBtn">
                    <i class="bi bi-box-arrow-right"></i>
                    Çıkış Yap
                </button>
            </div>
        </header>

        <!-- Content Area -->
        <div class="content-area">
            <div class="table-card">
                <div class="table-card-header">
                    <h2 class="table-card-title">
                        <i class="bi bi-shield-lock"></i>
                        Yönetici Listesi
                    </h2>
                    <button class="btn-add" data-bs-toggle="modal" data-bs-target="#newUserModal">
                        <i class="bi bi-person-plus"></i>
                        Yeni Yönetici Ekle
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table" id="usersTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Kullanıcı Adı</th>
                                <th>Oluşturulma Tarihi</th>
                                <th class="text-end">İşlemler</th>
                            </tr>
                        </thead>
                        <tbody id="usersTableBody">
                            <tr id="loadingRow">
                                <td colspan="4">
                                    <div class="loading-state">
                                        <div class="loading-spinner"></div>
                                        <p>Kullanıcılar yükleniyor...</p>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- New User Modal -->
    <div class="modal fade" id="newUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-plus me-2"></i>
                        Yeni Platform Yöneticisi
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form id="newUserForm">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı Adı</label>
                            <input type="text" class="form-control" name="username" id="newUsername" placeholder="admin" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Şifre</label>
                            <input type="password" class="form-control" name="password" id="newPassword" placeholder="••••••••" required>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-save" id="saveUserBtn">Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit User Modal -->
    <div class="modal fade" id="editUserModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-pencil-square me-2"></i>
                        Yönetici Düzenle
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form id="editUserForm">
                        <input type="hidden" id="editUserId">
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı Adı</label>
                            <input type="text" class="form-control" id="editUsername" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yeni Şifre</label>
                            <input type="password" class="form-control" id="editPassword" placeholder="Değiştirmek istemiyorsanız boş bırakın">
                            <div class="form-text">Boş bırakılırsa mevcut şifre korunur.</div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-save" id="updateUserBtn">Güncelle</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.2/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom JS -->
    <script src="{{ base_path }}/assets/js/config.js?v={{ version }}"></script>
    <script src="{{ base_path }}/assets/js/platform-users.js?v={{ version }}"></script>
</body>
</html>
