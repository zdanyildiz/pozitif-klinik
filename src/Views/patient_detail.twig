    {% include "components/payment_modal.twig" %}
{% endblock %}

{% block scripts %}
<script src="{{ base_path }}/assets/js/finance-shared.js?v={{ version }}"></script>
<script src="{{ base_path }}/assets/js/file-manager.js?v={{ version }}"></script>
<script src="{{ base_path }}/assets/js/lab-entry.js?v={{ version }}"></script>
<script>
    function openPatientPayment() {
        if (typeof PaymentModule !== 'undefined') {
            PaymentModule.open({
                patient_id: {{ patient.id }},
                total_debt: {{ totalDebt }},
                remaining_debt: {{ balance }}
            });
        }
    }

    // Refresh on payment
    window.addEventListener('payment-saved', () => {
        window.location.reload();
    });

    document.addEventListener('DOMContentLoaded', () => {


        // Init File Manager separately if needed or reuse logic
        if (typeof FileManager !== 'undefined') {
            new FileManager({
                module: 'patient',
                relatedId: {{ patient.id }},
                containerId: 'patient_file_list',
                uploadBtnId: 'patient_file_upload',
                csrfToken: '{{ csrf.value }}',
                customListUrl: `/api/files/search?patient_id={{ patient.id }}`
            });
        }
    });

    // Timeline Detail Functions
    let timelineOffcanvas;

    window.showTimelineDetail = async function(appointmentId, examinationId) {
        // Init Offcanvas if not already
        if (!timelineOffcanvas) {
            const el = document.getElementById('timelineOffcanvas');
            if (el) timelineOffcanvas = new bootstrap.Offcanvas(el);
        }

        // 1. Reset & Show Loading
        document.getElementById('offcanvasLoading').classList.remove('d-none');
        document.getElementById('offcanvasContent').classList.add('d-none');
        if (timelineOffcanvas) timelineOffcanvas.show();


        try {
            // 2. Fetch Data Parallel
            const fetchSafe = (url) => api.get(url).catch(() => ({ data: null }));
            
            let appt = null;
            let exam = null;

            if (appointmentId) {
                const [apptRes, examRes] = await Promise.all([
                    api.get(`/api/appointments/${appointmentId}`),
                    fetchSafe(`/api/examinations/appointment/${appointmentId}`)
                ]);
                appt = apptRes.data;
                exam = examRes.data;
            } else if (examinationId) {
                const examRes = await api.get(`/api/examinations/${examinationId}`);
                exam = examRes.data;
                // Mock appointment-like structure for the UI header
                appt = {
                    appointment_date: exam.created_at,
                    doctor_name: exam.doctor_name || 'Bilinmiyor',
                    type_name: 'Tıbbi Muayene Kaydı',
                    status_name: 'Tamamlandı',
                    status_color: '#10b981',
                    items: []
                };
            }

            if (!appt && !exam) throw new Error('Veri bulunamadı');

            // 3. Populate Data
            
            // Header
            document.getElementById('offcanvasDate').textContent = Utils.formatDate(appt.appointment_date);
            document.getElementById('offcanvasDoctor').textContent = appt.doctor_name || 'Belirtilmemiş';
            document.getElementById('offcanvasType').textContent = appt.type_name;
            const statusEl = document.getElementById('offcanvasStatus');
            statusEl.textContent = appt.status_name || appt.status;
            statusEl.className = 'badge';
            statusEl.style.backgroundColor = appt.status_color || '#6c757d';

            // Exam Details
            const examSection = document.getElementById('examSection');
            const examData = document.getElementById('examData');
            const examEmpty = document.getElementById('examEmpty');

            if (exam) {
                examData.classList.remove('d-none');
                examEmpty.classList.add('d-none');
                
                const setText = (id, val) => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = val || '-';
                };

                setText('offcanvasComplaint', exam.complaint);
                setText('offcanvasStory', exam.story);
                setText('offcanvasFindings', exam.bulgular);
                setText('offcanvasDiagnosis', exam.diagnosis);
                setText('offcanvasTreatment', exam.treatment);
                setText('offcanvasResult', exam.result_note);
            } else {
                examData.classList.add('d-none');
                examEmpty.classList.remove('d-none');
            }

            // Tetkik Sonuçları (Lab Result Text) - YENİ
            // Eğer veri varsa göster, yoksa gizle
            const labTextSection = document.getElementById('offcanvasLabTextSection');
            const labTextContent = document.getElementById('offcanvasLabText');
            
            if (labTextSection && labTextContent) {
                if (exam && exam.lab_result_text) {
                    labTextSection.classList.remove('d-none');
                    // Newlines to html breaks
                    labTextContent.textContent = exam.lab_result_text;
                } else {
                    labTextSection.classList.add('d-none');
                }
            }

            // Edit button visibility
            {% if permissions.can_edit_history %}
            currentApptId = appointmentId || null;
            const btnEdit = document.getElementById('btnEditExamOffcanvas');
            if (btnEdit) {
                if (exam && exam.id) {
                    currentExamData = exam;
                    btnEdit.classList.remove('d-none');
                } else {
                    currentExamData = null;
                    btnEdit.classList.add('d-none');
                }
            }
            {% endif %}

            // Services / Items
            const tbody = document.getElementById('offcanvasServices');
            const totalEl = document.getElementById('offcanvasTotal');
            
            if (tbody && totalEl) {
                tbody.innerHTML = '';
                let total = 0;

                if (appt.items && appt.items.length > 0) {
                    appt.items.forEach(item => {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td>
                                <div class="fw-medium">${item.item_name}</div>
                                <div class="text-muted small" style="font-size:0.75rem">Adet: ${item.quantity}</div>
                            </td>
                            <td class="text-end">${parseFloat(item.total_price).toFixed(2)} TL</td>
                        `;
                        tbody.appendChild(tr);
                        total += parseFloat(item.total_price);
                    });
                } else {
                    tbody.innerHTML = '<tr><td colspan="2" class="text-center text-muted small fst-italic">İşlem/Hizmet kaydı yok.</td></tr>';
                }
                totalEl.textContent = total.toFixed(2) + ' TL';
            }

            // 4. Show Content
            document.getElementById('offcanvasLoading').classList.add('d-none');
            document.getElementById('offcanvasContent').classList.remove('d-none');

        } catch (error) {
            console.error(error);
            const loadingEl = document.getElementById('offcanvasLoading');
            if (loadingEl) {
                loadingEl.innerHTML = '<div class="text-danger p-4"><i class="bi bi-exclamation-triangle fs-2"></i><br>Detaylar yüklenemedi.</div>';
            }
        }
    };

    {% if permissions.can_edit_history %}
    let currentExamData = null;
    let currentApptId = null;
    let examEditModalInst = null;

    window.editExamFromOffcanvas = function(isNew = false) {
        if (!isNew && (!currentExamData || !currentExamData.id)) return;
        
        if (isNew) {
            document.getElementById('editExamId').value = 'new';
            document.getElementById('editExamComplaint').value = '';
            document.getElementById('editExamStory').value = '';
            document.getElementById('editExamFindings').value = '';
            document.getElementById('editExamDiagnosis').value = '';
            document.getElementById('editExamTreatment').value = '';
            document.getElementById('editExamResultNote').value = '';
            document.getElementById('editExamLabResult').value = '';
        } else {
            document.getElementById('editExamId').value = currentExamData.id;
            document.getElementById('editExamComplaint').value = currentExamData.complaint || '';
            document.getElementById('editExamStory').value = currentExamData.story || '';
            document.getElementById('editExamFindings').value = currentExamData.bulgular || '';
            document.getElementById('editExamDiagnosis').value = currentExamData.diagnosis || '';
            document.getElementById('editExamTreatment').value = currentExamData.treatment || '';
            document.getElementById('editExamResultNote').value = currentExamData.result_note || '';
            document.getElementById('editExamLabResult').value = currentExamData.lab_result_text || '';
        }

        if (!examEditModalInst) {
            examEditModalInst = new bootstrap.Modal(document.getElementById('examEditModal'));
        }
        examEditModalInst.show();
    };

    window.saveExamEdit = async function() {
        const examId = document.getElementById('editExamId').value;
        if (!examId) return;

        const payload = {
            complaint: document.getElementById('editExamComplaint').value.trim(),
            story: document.getElementById('editExamStory').value.trim(),
            bulgular: document.getElementById('editExamFindings').value.trim(),
            diagnosis: document.getElementById('editExamDiagnosis').value.trim(),
            treatment: document.getElementById('editExamTreatment').value.trim(),
            result_note: document.getElementById('editExamResultNote').value.trim(),
            lab_result_text: document.getElementById('editExamLabResult').value.trim()
        };

        const btn = document.getElementById('btnSaveExamEdit');
        const originalHtml = btn.innerHTML;

        try {
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Kaydediliyor...';
            btn.disabled = true;

            let res;
            if (examId === 'new') {
                payload.patient_id = {{ patient.id }};
                payload.appointment_id = currentApptId;
                
                // Eğer randevu yoksa boş kayıt (randevusuz muayene) hatası olabilir mi? currentApptId null olabilir.
                // Randevu ID si varsa gönderiyoruz.
                res = await api.post(`/api/examinations`, payload);
            } else {
                res = await api.put(`/api/examinations/${examId}`, payload);
            }
            
            // Axios interceptor returns response.data directly on success
            if (res && res.status) {
                examEditModalInst.hide();
                Swal.fire({
                    icon: 'success',
                    title: 'Başarılı',
                    text: 'Geçmiş muayene bilgileri güncellendi.',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => {
                    window.location.reload();
                });
            }
        } catch (error) {
            console.error('Save exam error', error);
            btn.innerHTML = '<i class="bi bi-check-lg me-1"></i>Değişiklikleri Kaydet';
            btn.disabled = false;
            
            // Error handling matching interceptor strings
            const errorMsg = typeof error === 'string' ? error : (error.response?.data?.message || 'Muayene güncellenirken bir hata oluştu.');
            Swal.fire('Hata', errorMsg, 'error');
        }
    };
    {% endif %}
</script>
{% endblock %}
