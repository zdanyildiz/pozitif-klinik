{% extends 'layout.twig' %}

{% block title %}{{ patient.name }} - Hasta Detayı{% endblock %}

{% block head %}
    <link href="{{ base_path }}/assets/css/file-manager.css?v={{ version }}" rel="stylesheet">
    <link href="{{ base_path }}/assets/css/patient-detail.css?v={{ version }}" rel="stylesheet">
{% endblock %}

{% block page_title %}
    <a href="{{ base_path }}/admin/patients" class="text-decoration-none text-secondary me-2">
        <i class="bi bi-arrow-left"></i>
    </a>
    Hasta Detayı
{% endblock %}

{% block content %}
<div class="container-fluid p-0">
    <!-- Header Section -->
    <div class="patient-header d-flex flex-column flex-md-row align-items-center gap-4">
        <div class="avatar-circle">
            <span class="bi bi-person"></span>
        </div>
        
        <div class="flex-grow-1 text-center text-md-start">
            <h2 class="fw-bold mb-1">{{ patient.name }}</h2>
            <div class="d-flex flex-wrap justify-content-center justify-content-md-start gap-2 mt-2">
                <div class="info-pill">
                    <i class="bi bi-upc-scan"></i> {{ patient.tc_no }}
                </div>
                <div class="info-pill">
                    <i class="bi bi-telephone"></i> {{ patient.phone }}
                </div>
                <div class="info-pill">
                    <i class="bi bi-droplet"></i> {{ patient.blood_type|default('Bilinmiyor') }}
                </div>
                <div class="info-pill">
                    <i class="bi bi-cake"></i> {{ patient.birth_date ? patient.birth_date : '-' }}
                </div>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3 mt-md-0 align-self-md-end mb-md-2">
            <a href="{{ base_path }}/admin/patients/{{ patient.id }}/edit" class="btn action-btn rounded-pill px-4 text-decoration-none" id="btnEditPatient">
                <i class="bi bi-pencil me-2"></i>Düzenle
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Info -->
        <div class="col-lg-3">
            {% if permissions.can_view_patient_finance %}
            <div class="card card-glass mb-4">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3 text-secondary">Finansal Özet</h5>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Toplam Borç</span>
                        <span class="fw-bold text-danger">{{ totalDebt|number_format(2, ',', '.') }} TL</span>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted">Ödenen</span>
                        <span class="fw-bold text-success">{{ totalPaid|number_format(2, ',', '.') }} TL</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Bakiye</span>
                        <span class="fw-bold text-primary">{{ balance|number_format(2, ',', '.') }} TL</span>
                    </div>
                    {% if balance > 0 %}
                    <div class="d-grid mt-3">
                        <button class="btn btn-success shadow-sm" onclick="openPatientPayment()">
                            <i class="bi bi-cash-coin me-2"></i>Tahsilat Al
                        </button>
                    </div>
                    {% endif %}
                </div>
            </div>
            {% endif %}

            <div class="card card-glass">
                <div class="card-body">
                    <h5 class="card-title fw-bold mb-3 text-secondary">İletişim & Adres</h5>
                    <p class="mb-1 text-muted"><i class="bi bi-geo-alt me-2"></i>{{ patient.address }}</p>
                    <p class="mb-1 text-muted">{{ patient.district_name }} / {{ patient.province_name }}</p>
                    <hr>
                    <p class="mb-1 text-muted"><i class="bi bi-envelope me-2"></i>{{ patient.email|default('-') }}</p>
                </div>
            </div>
            
            <div class="card card-glass mt-4">
                <div class="card-body">
                     <h5 class="card-title fw-bold mb-3 text-secondary">Notlar</h5>
                     <p class="text-muted small">{{ patient.notes|default('Not eklenmemiş.') }}</p>
                </div>
            </div>
        </div>

        <!-- Main Content (Timeline & Tabs) -->
        <div class="col-lg-9">
            <div class="card card-glass border-0">
                <div class="card-header bg-transparent border-bottom-0 p-0">
                    <ul class="nav nav-tabs border-bottom" id="patientTabs" role="tablist">
                        <li class="nav-item">
                            <button class="nav-link tab-link-custom active" id="timeline-tab" data-bs-toggle="tab" data-bs-target="#timeline" type="button">
                                <i class="bi bi-clock-history me-2"></i>Zaman Tüneli
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link tab-link-custom" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button">
                                <i class="bi bi-person-vcard me-2"></i>Profil
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link tab-link-custom" id="labs-tab" data-bs-toggle="tab" data-bs-target="#labs" type="button">
                                <i class="bi bi-eyedropper me-2"></i>Laboratuvar
                            </button>
                        </li>
                        <li class="nav-item">
                            <button class="nav-link tab-link-custom" id="files-tab" data-bs-toggle="tab" data-bs-target="#files" type="button">
                                <i class="bi bi-folder2-open me-2"></i>Dosyalar
                            </button>
                        </li>
                    </ul>
                </div>
                <div class="card-body p-4">
                    <div class="tab-content" id="patientTabsContent">
                        
                        <!-- Timeline Tab -->
                        <div class="tab-pane fade show active" id="timeline" role="tabpanel">
                            <div class="timeline-container">
                                {% if timeline is empty %}
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-calendar-x fs-1 opacity-50"></i>
                                        <p class="mt-3">Henüz geçmiş randevu veya işlem bulunmuyor.</p>
                                    </div>
                                {% else %}
                                    {% for item in timeline %}
                                    <div class="timeline-item" style="cursor: pointer;" onclick="showTimelineDetail({{ item.appointment_id|default('null') }}, {{ item.examination_id|default('null') }})">
                                        <div class="timeline-dot" style="border-color: {{ item.color }};"></div>
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">
                                                    {% if item.entry_type == 'examination' %}
                                                        <i class="bi bi-file-medical-fill text-success me-1"></i>
                                                    {% endif %}
                                                    {{ item.title }}
                                                </h6>
                                                <small class="text-muted">{{ item.date|date('d.m.Y H:i') }}</small>
                                                <span class="ms-2 badge bg-light text-secondary border border-secondary fw-normal" style="font-size: 0.7rem;">
                                                    <i class="bi bi-info-circle me-1"></i>Detay
                                                </span>
                                            </div>
                                            <span class="badge" style="background-color: {{ item.status_color }}">
                                                {{ item.status_name }}
                                            </span>
                                        </div>
                                        
                                        <div class="bg-light p-3 rounded-3 mb-2">
                                            <div class="d-flex align-items-center gap-2 mb-2">
                                                <div class="avatar-sm rounded-circle bg-white d-flex align-items-center justify-content-center shadow-sm" style="width: 24px; height: 24px;">
                                                    <i class="bi bi-person-fill text-muted" style="font-size: 12px;"></i>
                                                </div>
                                                <small class="fw-bold text-secondary">{{ item.doctor_name }}</small>
                                            </div>
                                            {% if item.notes %}
                                                <p class="mb-0 text-muted small text-truncate" style="max-height: 3.6em; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical;">
                                                    {{ item.notes }}
                                                </p>
                                            {% endif %}
                                            
                                            {% if item.examination %}
                                                <div class="mt-3 pt-2 border-top border-secondary-subtle">
                                                    <div class="d-flex gap-2 mb-1">
                                                        <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Tanı</span>
                                                        <span class="text-dark small fw-medium">{{ item.examination.diagnosis|default('Tanı girilmedi') }}</span>
                                                    </div>
                                                    {% if item.examination.result_note %}
                                                        <div class="small text-muted fst-italic text-truncate">"{{ item.examination.result_note }}"</div>
                                                    {% endif %}
                                                    {% if item.examination.lab_result_text %}
                                                        <div class="mt-2 small text-secondary">
                                                            <i class="bi bi-eyedropper me-1"></i>Tetkik Sonuçları mevcut
                                                        </div>
                                                    {% endif %}
                                                </div>
                                            {% endif %}
                                            
                                            {% if item.files is not empty %}
                                                <div class="mt-3 pt-2 border-top border-secondary-subtle">
                                                    <div class="d-flex flex-wrap gap-2">
                                                        {% for file in item.files %}
                                                            {% set cat_icons = {
                                                                'radiology': 'bi-x-ray',
                                                                'lab': 'bi-eyedropper',
                                                                'report': 'bi-file-earmark-medical',
                                                                'prescription': 'bi-capsule',
                                                                'other': 'bi-file-earmark'
                                                            } %}
                                                            <a href="/api/files/view/{{ file.uuid }}" target="_blank" 
                                                               class="btn btn-white btn-sm border shadow-xs rounded-3 px-2 py-1 d-inline-flex align-items-center gap-2 {{ file.mime_type starts with 'image' ? 'preview-file' : '' }}"
                                                               data-title="{{ file.display_name|default(file.original_name) }}"
                                                               style="font-size: 0.75rem;">
                                                                <i class="bi {{ cat_icons[file.file_category]|default('bi-file-earmark') }} text-primary"></i>
                                                                <span class="text-dark fw-medium">{{ file.display_name|default(file.original_name) }}</span>
                                                            </a>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            {% endif %}
                                        </div>
                                    </div>
                                    {% endfor %}
                                {% endif %}
                            </div>
                        </div>

                        <!-- Profile Tab (NEW) -->
                        <div class="tab-pane fade" id="profile" role="tabpanel">
                            <h6 class="fw-bold mb-4">Detaylı Hasta Bilgileri</h6>
                            
                            <div class="row g-4">
                                <!-- Identity Details -->
                                <div class="col-md-6">
                                    <div class="card h-100 border bg-light-subtle">
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold text-secondary mb-3"><i class="bi bi-person-lines-fill me-2"></i>Kimlik Bilgileri</h6>
                                            <table class="table table-sm table-borderless mb-0">
                                                <tr>
                                                    <td class="text-muted w-50">Baba Adı:</td>
                                                    <td class="fw-medium">{{ patient.identity_details.father_name|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Anne Adı:</td>
                                                    <td class="fw-medium">{{ patient.identity_details.mother_name|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Doğum Yeri:</td>
                                                    <td class="fw-medium">{{ patient.identity_details.birth_place|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Medeni Hal:</td>
                                                    <td class="fw-medium">{{ patient.identity_details.marital_status|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Uyruk:</td>
                                                    <td class="fw-medium">{{ patient.identity_details.nationality|default('TR') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Vergi No:</td>
                                                    <td class="fw-medium">{{ patient.identity_details.tax_no|default('-') }}</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Work Details -->
                                <div class="col-md-6">
                                    <div class="card h-100 border bg-light-subtle">
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold text-secondary mb-3"><i class="bi bi-briefcase me-2"></i>Çalışma Bilgileri</h6>
                                            <table class="table table-sm table-borderless mb-0">
                                                <tr>
                                                    <td class="text-muted w-50">Meslek:</td>
                                                    <td class="fw-medium">{{ patient.work_details.profession|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Şirket:</td>
                                                    <td class="fw-medium">{{ patient.work_details.company_name|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">Ünvan/Rol:</td>
                                                    <td class="fw-medium">{{ patient.work_details.role|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">İş Telefonu:</td>
                                                    <td class="fw-medium">{{ patient.work_details.phone|default('-') }}</td>
                                                </tr>
                                                <tr>
                                                    <td class="text-muted">İş E-postası:</td>
                                                    <td class="fw-medium">{{ patient.work_details.email|default('-') }}</td>
                                                </tr>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <!-- Medical Info -->
                                <div class="col-md-6">
                                    <div class="card h-100 border bg-light-subtle">
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold text-danger mb-3"><i class="bi bi-heart-pulse me-2"></i>Tıbbi Uyarılar</h6>
                                            
                                            <div class="mb-3">
                                                <label class="small text-muted fw-bold">Kronik Hastalıklar</label>
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    {% if patient.medical_info.chronic_diseases is not empty %}
                                                        {% for disease in patient.medical_info.chronic_diseases %}
                                                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle">{{ disease }}</span>
                                                        {% endfor %}
                                                    {% else %}
                                                        <span class="text-muted small fst-italic">-</span>
                                                    {% endif %}
                                                </div>
                                            </div>

                                            <div class="mb-3">
                                                <label class="small text-muted fw-bold">Alerjiler</label>
                                                <div class="mt-1">
                                                     {% if patient.medical_info.allergies is not empty %}
                                                        {% for type, allergy in patient.medical_info.allergies %}
                                                            <div class="d-flex align-items-center mb-1">
                                                                <span class="badge bg-warning text-dark me-2">{{ type|capitalize }}</span>
                                                                <span class="small">{{ allergy }}</span>
                                                            </div>
                                                        {% endfor %}
                                                     {% else %}
                                                        <span class="text-muted small fst-italic">-</span>
                                                     {% endif %}
                                                </div>
                                            </div>
                                            
                                            <div>
                                                 <label class="small text-muted fw-bold">Önemli Uyarılar</label>
                                                 <p class="mb-0 small text-dark temp-text-pre-wrap">{{ patient.medical_info.warnings|default('-') }}</p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Insurance Info -->
                                <div class="col-md-6">
                                    <div class="card h-100 border bg-light-subtle">
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold text-secondary mb-3"><i class="bi bi-shield-check me-2"></i>Sigorta Bilgileri</h6>
                                            
                                            <div class="mb-3">
                                                 <label class="small text-muted fw-bold">SGK Durumu</label>
                                                 <div class="mt-1">
                                                     <span class="badge bg-info-subtle text-info-emphasis border border-info-subtle px-3 py-2">
                                                         {{ patient.insurance_info.sgk_status|default('Bilinmiyor') }}
                                                     </span>
                                                 </div>
                                            </div>

                                            <div>
                                                <label class="small text-muted fw-bold mb-2">Özel Sigorta Poliçeleri</label>
                                                {% if patient.insurance_info.policies is not empty %}
                                                    <ul class="list-group list-group-flush bg-transparent">
                                                        {% for policy in patient.insurance_info.policies %}
                                                            <li class="list-group-item bg-transparent px-0 py-1 d-flex justify-content-between align-items-center small">
                                                                <span class="fw-medium">{{ policy.company|default('Şirket Yok') }}</span>
                                                                <span class="text-muted">{{ policy.policy_no|default('-') }}</span>
                                                            </li>
                                                        {% endfor %}
                                                    </ul>
                                                {% else %}
                                                    <p class="mb-0 text-muted small fst-italic">-</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Legal Consents -->
                                <div class="col-12">
                                     <div class="card border bg-light-subtle">
                                        <div class="card-body">
                                            <h6 class="card-title fw-bold text-secondary mb-3"><i class="bi bi-file-earmark-lock me-2"></i>Yasal İzinler & Onaylar</h6>
                                            <div class="d-flex gap-4 flex-wrap">
                                                <div class="d-flex align-items-center">
                                                    <i class="bi {{ patient.legal_consents.kvkk.is_accepted ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-secondary' }} fs-5 me-2"></i>
                                                    <div>
                                                        <div class="fw-medium">KVKK Aydınlatma Metni</div>
                                                        <small class="text-muted">{{ patient.legal_consents.kvkk.accepted_at ? patient.legal_consents.kvkk.accepted_at|date('d.m.Y H:i') : 'Onaylanmadı' }}</small>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi {{ patient.legal_consents.etk.sms.allowed ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-secondary' }} fs-5 me-2"></i>
                                                    <div>
                                                        <div class="fw-medium">SMS İzni (ETK)</div>
                                                        <small class="text-muted">{{ patient.legal_consents.etk.sms.allowed ? 'İzinli' : 'İzinsiz' }}</small>
                                                    </div>
                                                </div>
                                                <div class="d-flex align-items-center">
                                                    <i class="bi {{ patient.legal_consents.etk.email.allowed ? 'bi-check-circle-fill text-success' : 'bi-x-circle-fill text-secondary' }} fs-5 me-2"></i>
                                                    <div>
                                                        <div class="fw-medium">E-posta İzni (ETK)</div>
                                                        <small class="text-muted">{{ patient.legal_consents.etk.email.allowed ? 'İzinli' : 'İzinsiz' }}</small>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                     </div>
                                </div>

                                <!-- Legacy Metadata (Technical Info) -->
                                {% if patient.legacy_metadata is not empty %}
                                <div class="col-12">
                                    <div class="accordion" id="legacyAccord">
                                        <div class="accordion-item bg-transparent border-0">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed py-2 bg-light rounded shadow-sm text-muted small" type="button" data-bs-toggle="collapse" data-bs-target="#legacyData">
                                                    <i class="bi bi-code-slash me-2"></i>Teknik Veri (Legacy Metadata)
                                                </button>
                                            </h2>
                                            <div id="legacyData" class="accordion-collapse collapse" data-bs-parent="#legacyAccord">
                                                <div class="accordion-body">
                                                    <pre class="small bg-dark text-light p-3 rounded mb-0" style="max-height: 200px; overflow-y: auto;">{{ patient.legacy_metadata|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% endif %}

                            </div>
                        </div>
                        
                        <!-- Laboratories Tab -->
                        <div class="tab-pane fade" id="labs" role="tabpanel">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="mb-0 fw-bold">Laboratuvar Sonuçları</h6>
                                <button class="btn btn-sm btn-outline-primary" onclick="LabEntry.openModal()">
                                    <i class="bi bi-plus-lg me-1"></i> Yeni Sonuç Ekle
                                </button>
                            </div>

                            {% if labResults is empty %}
                                <div class="text-center py-5 text-muted">
                                    <i class="bi bi-clipboard-data fs-1 opacity-50"></i>
                                    <p class="mt-3">Henüz laboratuvar sonucu bulunmuyor.</p>
                                </div>
                            {% else %}
                                <div class="accordion accordion-flush" id="labAccordion">
                                    {% for result in labResults %}
                                        <div class="accordion-item border rounded mb-3 overflow-hidden">
                                            <h2 class="accordion-header">
                                                <button class="accordion-button collapsed bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#lab-{{ result.id }}">
                                                    <div class="d-flex flex-column flex-md-row align-items-md-center gap-2 gap-md-4 w-100">
                                                        <span class="fw-bold text-dark"><i class="bi bi-file-earmark-medical me-2"></i>Lab Sonucu #{{ result.id }}</span>
                                                        <span class="text-muted small"><i class="bi bi-calendar-event me-1"></i>{{ result.result_date|date('d.m.Y') }}</span>
                                                        {% if result.doctor_name %}
                                                            <span class="text-muted small"><i class="bi bi-person me-1"></i>{{ result.doctor_name }}</span>
                                                        {% endif %}
                                                        <div class="ms-auto me-3 d-flex align-items-center">
                                                            <span class="badge bg-success">{{ result.items|length }} Test</span>
                                                            <span role="button" class="text-secondary ms-3" onclick="LabEntry.deleteResult({{ result.id }}); event.stopPropagation();" title="Sonucu Sil">
                                                                <i class="bi bi-trash"></i>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </button>
                                            </h2>
                                            <div id="lab-{{ result.id }}" class="accordion-collapse collapse" data-bs-parent="#labAccordion">
                                                <div class="accordion-body p-0">
                                                    <div class="table-responsive">
                                                        <table class="table table-hover mb-0">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th style="width: 40%">Test Adı</th>
                                                                    <th>Sonuç</th>
                                                                    <th>Referans Aralığı</th>
                                                                    <th>Durum</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                {% for item in result.items %}
                                                                    <tr class="{{ item.is_abnormal ? 'table-danger-subtle' : '' }}">
                                                                        <td class="fw-medium">{{ item.test_name }}</td>
                                                                        <td class="{{ item.is_abnormal ? 'text-danger fw-bold' : '' }}">
                                                                            {{ item.result_value }} {{ item.unit }}
                                                                        </td>
                                                                        <td class="text-muted small">{{ item.reference_range }}</td>
                                                                        <td>
                                                                            {% if item.is_abnormal %}
                                                                                <span class="badge bg-danger">Anormal</span>
                                                                            {% else %}
                                                                                <span class="badge bg-success">Normal</span>
                                                                            {% endif %}
                                                                        </td>
                                                                    </tr>
                                                                {% endfor %}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>

                        <!-- Files Tab -->
                        <div class="tab-pane fade" id="files" role="tabpanel">
                             <div class="d-flex justify-content-between align-items-center mb-4">
                                <h6 class="mb-0 fw-bold">Dosyalar</h6>
                                <div>
                                    <button type="button" id="patient_file_upload" class="btn btn-sm btn-outline-primary shadow-sm rounded-pill px-3">
                                        <i class="bi bi-cloud-upload me-1"></i> Yeni Dosya Yükle
                                    </button>
                                </div>
                            </div>
                            <div id="patient_file_list" class="border rounded bg-light p-3" style="min-height: 200px;">
                                <!-- File Manager JS will populate this -->
                                <div class="text-center p-5 text-muted">
                                    <div class="spinner-border spinner-border-sm me-2"></div> Dosyalar yükleniyor...
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Offcanvas for Timeline Detail -->
<div class="offcanvas offcanvas-end" tabindex="-1" id="timelineOffcanvas" aria-labelledby="timelineOffcanvasLabel" style="width: 500px;">
    <!-- ... (Existing Offcanvas Content) ... -->
    <div class="offcanvas-header bg-white border-bottom sticky-top">
        <div>
            <h5 class="offcanvas-title fw-bold" id="timelineOffcanvasLabel">Randevu Detayı</h5>
            <small class="text-muted" id="offcanvasDate">...</small>
        </div>
        <div class="d-flex align-items-center gap-2">
            {% if permissions.can_edit_history %}
            <button type="button" class="btn btn-sm btn-outline-primary d-none" id="btnEditExamOffcanvas" onclick="editExamFromOffcanvas()">
                <i class="bi bi-pencil me-1"></i>Düzenle
            </button>
            {% endif %}
            <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Kapat" style="filter: none; opacity: 1;"></button>
        </div>
    </div>
    <div class="offcanvas-body p-0">
        <div id="offcanvasLoading" class="text-center p-5">
            <div class="spinner-border text-primary"></div>
            <p class="mt-2 text-muted">Detaylar yükleniyor...</p>
        </div>
        
        <div id="offcanvasContent" class="d-none">
             <!-- ... (Existing content inside offcanvas) ... -->
            <!-- Doktor & Tür Bilgisi -->
            <div class="p-4 border-bottom bg-white">
                <div class="d-flex align-items-center mb-3">
                    <div class="avatar-sm rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px; font-size: 1.2rem;">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-0" id="offcanvasDoctor">Dr. -</h6>
                        <span class="badge bg-secondary" id="offcanvasType">-</span>
                        <span class="badge bg-light text-dark border ms-1" id="offcanvasStatus">-</span>
                    </div>
                </div>
            </div>

            <!-- Muayene Bulguları (Varsa) -->
            <div id="examSection" class="p-4 border-bottom">
                <div id="examData">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-file-medical me-2"></i>Klinik Notlar
                    </h6>
                    
                    <div class="mb-3">
                        <label class="small text-muted fw-bold text-uppercase">Şikayet</label>
                        <p class="mb-0" id="offcanvasComplaint">-</p>
                    </div>
                    
                    <div class="mb-3">
                        <label class="small text-muted fw-bold text-uppercase">Hikaye</label>
                        <p class="mb-0" id="offcanvasStory">-</p>
                    </div>
                    
                    <div class="mb-3">
                        <label class="small text-muted fw-bold text-uppercase">Bulgular</label>
                        <p class="mb-0" id="offcanvasFindings">-</p>
                    </div>

                    <div class="p-3 bg-light rounded border mb-3">
                        <label class="small text-muted fw-bold text-uppercase text-primary">Tanı (Diagnöz)</label>
                        <p class="mb-0 fw-bold text-dark" id="offcanvasDiagnosis">-</p>
                    </div>

                    <div class="mb-3">
                        <label class="small text-muted fw-bold text-uppercase">Tedavi / Plan</label>
                        <p class="mb-0" id="offcanvasTreatment">-</p>
                    </div>
                    
                     <div class="mb-0">
                        <label class="small text-muted fw-bold text-uppercase">Sonuç Notu</label>
                        <p class="mb-0 fst-italic text-secondary" id="offcanvasResult">-</p>
                    </div>
                </div>
                <div id="examEmpty" class="text-center text-muted py-3 d-none">
                    <i class="bi bi-journal-x fs-4"></i>
                    <br>Bu randevu için doktor muayene notu girilmemiş.
                    {% if permissions.can_edit_history %}
                    <div class="mt-3">
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="editExamFromOffcanvas(true)">
                            <i class="bi bi-plus-lg me-1"></i>Yeniden Not Ekle
                        </button>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Tetkik Sonuçları (Metin) -->
            <div id="offcanvasLabTextSection" class="p-4 border-bottom d-none bg-light-subtle">
                <h6 class="fw-bold text-dark mb-3">
                    <i class="bi bi-eyedropper me-2"></i>Tetkik Sonuçları
                </h6>
                <div class="bg-white p-3 border rounded">
                    <p class="mb-0 text-secondary small" id="offcanvasLabText" style="white-space: pre-wrap;">-</p>
                </div>
            </div>

            {% if permissions.can_view_patient_finance %}
            <!-- Hizmetler / İşlemler -->
            <div class="p-4">
                <h6 class="fw-bold text-success mb-3">
                    <i class="bi bi-receipt me-2"></i>Yapılan İşlemler (Hizmetler)
                </h6>
                <div class="table-responsive">
                    <table class="table table-sm table-borderless mb-0">
                        <thead class="text-muted border-bottom">
                            <tr>
                                <th class="text-end">Tutar</th>
                            </tr>
                        </thead>
                        <tbody id="offcanvasServices">
                            <!-- JS populate -->
                        </tbody>
                        <tfoot class="border-top fw-bold">
                            <tr>
                                <td>TOPLAM</td>
                                <td class="text-end" id="offcanvasTotal">0.00 TL</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>

{% if permissions.can_edit_history %}
<!-- Examination Edit Modal -->
<div class="modal fade" id="examEditModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg modal-dialog-centered">
