<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pozitif Klinik - Klinik Ayarları Yönetimi">
    <title>Klinik Ayarları | Pozitif Klinik Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="{{ base_path }}/assets/css/dashboard.css?v={{ version }}" rel="stylesheet">
    <link href="{{ base_path }}/assets/css/clinic-settings.css?v={{ version }}" rel="stylesheet">
</head>

<body>
    <!-- Sidebar -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <a href="{{ base_path }}/platform/dashboard" class="sidebar-logo">
                <div class="sidebar-logo-icon"><i class="bi bi-hospital"></i></div>
                <div class="sidebar-logo-text">Pozitif<span>Platform Yönetimi</span></div>
            </a>
        </div>

        <nav class="sidebar-nav">
            <div class="nav-section">
                <div class="nav-section-title">Ana Menü</div>
                <a href="{{ base_path }}/platform/dashboard" class="nav-link-custom">
                    <i class="bi bi-building"></i>Klinikler
                </a>
                <a href="{{ base_path }}/platform/users" class="nav-link-custom"><i class="bi bi-people"></i>Kullanıcılar</a>
                <a href="#" class="nav-link-custom"><i class="bi bi-bar-chart"></i>İstatistikler</a>
            </div>
            <div class="nav-section">
                <div class="nav-section-title">Sistem</div>
                <a href="#" class="nav-link-custom active"><i class="bi bi-gear"></i>Klinik Ayarları</a>
                <a href="{{ base_path }}/platform/logs" class="nav-link-custom"><i class="bi bi-file-text"></i>Loglar</a>
            </div>
        </nav>
    </aside>

    <!-- Main Content -->
    <main class="main-content">
        <header class="top-navbar">
            <div class="navbar-breadcrumb">
                <a href="{{ base_path }}/platform/dashboard" class="breadcrumb-link"><i class="bi bi-house"></i></a>
                <span class="breadcrumb-separator">/</span>
                <a href="{{ base_path }}/platform/dashboard" class="breadcrumb-link">Klinikler</a>
                <span class="breadcrumb-separator">/</span>
                <span class="breadcrumb-current" id="clinicNameBreadcrumb">Klinik Ayarları</span>
            </div>
            <div class="navbar-actions">
                <button class="btn-logout" id="logoutBtn"><i class="bi bi-box-arrow-right"></i>Çıkış Yap</button>
            </div>
        </header>

        <div class="content-area">
            <div class="clinic-header-card" id="clinicHeaderCard">
                <div class="clinic-header-content">
                    <div class="clinic-avatar" id="clinicAvatar"><i class="bi bi-building"></i></div>
                    <div class="clinic-info">
                        <h1 class="clinic-title" id="clinicTitle">Yükleniyor...</h1>
                        <div class="clinic-meta">
                            <span class="clinic-meta-item"><i class="bi bi-globe2"></i><span id="clinicDomain">-</span></span>
                            <span class="clinic-meta-item" id="clinicStatusBadge"><i class="bi bi-circle-fill"></i><span>-</span></span>
                        </div>
                    </div>
                </div>
                <div class="clinic-header-actions">
                    <a href="{{ base_path }}/platform/dashboard" class="btn-back"><i class="bi bi-arrow-left"></i>Listeye Dön</a>
                </div>
            </div>

            <div class="settings-container">
                <div class="settings-tabs">
                    <button class="settings-tab active" data-tab="email"><i class="bi bi-envelope"></i>E-posta Ayarları</button>
                    <button class="settings-tab" data-tab="users"><i class="bi bi-people"></i>Kullanıcılar</button>
                    <button class="settings-tab" data-tab="general"><i class="bi bi-sliders"></i>Genel Ayarlar</button>
                    <button class="settings-tab" data-tab="notifications"><i class="bi bi-bell"></i>Bildirimler</button>
                </div>

                <div class="settings-panel active" id="emailPanel">
                    <!-- Same Email Settings Panel Content -->
                    <div class="settings-panel-header">
                        <div class="panel-header-info">
                            <h2 class="panel-title"><i class="bi bi-envelope-at"></i>SMTP E-posta Yapılandırması</h2>
                            <p class="panel-description">Bu klinik için özel e-posta sunucu ayarlarını yapılandırın.</p>
                        </div>
                        <div class="panel-header-badge" id="emailConfigBadge">
                            <span class="badge-fallback"><i class="bi bi-info-circle"></i>Sistem Varsayılanı</span>
                        </div>
                    </div>
                    <form id="emailSettingsForm" class="settings-form">
                        <div class="form-section">
                            <h3 class="form-section-title"><i class="bi bi-server"></i>SMTP Sunucu Bilgileri</h3>
                            <div class="row g-3">
                                <div class="col-md-8">
                                    <label class="form-label">SMTP Sunucu Adresi</label>
                                    <input type="text" class="form-control" id="smtpHost" placeholder="smtp.example.com" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Port</label>
                                    <input type="number" class="form-control" id="smtpPort" placeholder="587" value="587" required>
                                </div>
                            </div>
                            <!-- ... rest of the form ... -->
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label class="form-label">Kullanıcı Adı</label>
                                    <input type="text" class="form-control" id="smtpUsername" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Şifre</label>
                                    <div class="input-group">
                                        <input type="password" class="form-control" id="smtpPassword">
                                        <button type="button" class="btn btn-outline-secondary" id="togglePassword"><i class="bi bi-eye"></i></button>
                                    </div>
                                    <div id="passwordHint" class="form-text text-warning mt-1" style="display:none;"></div>
                                </div>
                            </div>
                            <div class="row g-3 mt-2">
                                <div class="col-md-6">
                                    <label class="form-label">Şifreleme Türü</label>
                                    <select class="form-select" id="smtpEncryption">
                                        <option value="tls">TLS</option>
                                        <option value="ssl">SSL</option>
                                        <option value="none">Yok</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Durum</label>
                                    <select class="form-select" id="smtpActive">
                                        <option value="1">Aktif</option>
                                        <option value="0">Pasif</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="form-section">
                            <h3 class="form-section-title"><i class="bi bi-person-badge"></i>Gönderen Bilgileri</h3>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label">Gönderen E-posta</label>
                                    <input type="email" class="form-control" id="fromEmail" required>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">Gönderen Adı</label>
                                    <input type="text" class="form-control" id="fromName" required>
                                </div>
                            </div>
                        </div>
                        <div class="form-actions">
                            <div class="form-actions-left">
                                <button type="button" class="btn btn-outline-danger" id="resetToFallbackBtn">Varsayılana Dön</button>
                            </div>
                            <div class="form-actions-right">
                                <button type="button" class="btn btn-outline-primary" id="testConnectionBtn">Test Bağlantı</button>
                                <button type="button" class="btn btn-outline-success" id="sendTestEmailBtn">Test E-posta</button>
                                <button type="submit" class="btn btn-primary" id="saveEmailSettingsBtn">Kaydet</button>
                            </div>
                        </div>
                    </form>
                </div>

                <div class="settings-panel" id="usersPanel">
                    <div class="settings-panel-header">
                        <div class="panel-header-info">
                            <h2 class="panel-title"><i class="bi bi-people-fill"></i>Klinik Personelleri</h2>
                            <p class="panel-description">Bu kliniğe tanımlı doktor, sekreter ve yöneticileri yönetin.</p>
                        </div>
                        <button class="btn btn-primary btn-sm" id="btnAddNewPersonnel">
                            <i class="bi bi-person-plus"></i> Yeni Personel
                        </button>
                    </div>
                    
                    <div class="table-responsive">
                        <table class="table table-hover align-middle" id="personnelTable">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Ad Soyad</th>
                                    <th>Kullanıcı Adı</th>
                                    <th>Rol</th>
                                    <th>Durum</th>
                                    <th class="text-end">İşlemler</th>
                                </tr>
                            </thead>
                            <tbody id="personnelTableBody">
                                <tr>
                                    <td colspan="6" class="text-center py-4">
                                        <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                                        Kullanıcılar yükleniyor...
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="settings-panel" id="generalPanel">
                    <div class="settings-panel-header">
                        <div class="panel-header-info">
                            <h2 class="panel-title"><i class="bi bi-sliders"></i>Genel Klinik Ayarları</h2>
                            <p class="panel-description">Klinik temel bilgilerini ve uygulama tercihlerini yönetin.</p>
                        </div>
                    </div>
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-cone-striped fs-1 d-block mb-3"></i>
                        <p>Genel ayarlar modülü yakında hizmete girecektir.</p>
                    </div>
                </div>

                <div class="settings-panel" id="notificationsPanel">
                    <div class="settings-panel-header">
                        <div class="panel-header-info">
                            <h2 class="panel-title"><i class="bi bi-bell-fill"></i>Bildirim Yapılandırması</h2>
                            <p class="panel-description">SMS ve E-posta bildirim tercihlerini özelleştirin.</p>
                        </div>
                    </div>
                    <div class="p-5 text-center text-muted">
                        <i class="bi bi-cone-striped fs-1 d-block mb-3"></i>
                        <p>Bildirim ayarları modülü yakında hizmete girecektir.</p>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Test Email Modal -->
    <div class="modal fade" id="testEmailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Test E-postası Gönder</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Alıcı E-posta Adresi</label>
                        <input type="email" class="form-control" id="testEmailAddress" placeholder="ornek@mail.com" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-save" id="confirmSendTestBtn">Gönder</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Personnel Modal -->
    <div class="modal fade" id="personnelModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="personnelModalTitle">Yeni Personel Ekle</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form id="personnelForm">
                        <input type="hidden" id="personnelId">
                        <div class="mb-3">
                            <label class="form-label">Ad Soyad</label>
                            <input type="text" class="form-control" id="personnelName" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kullanıcı Adı</label>
                            <input type="text" class="form-control" id="personnelUsername" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Rol</label>
                            <select class="form-select" id="personnelRole" required>
                                <option value="admin">Yönetici</option>
                                <option value="doctor">Doktor</option>
                                <option value="secretary">Sekreter</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Şifre</label>
                            <input type="password" class="form-control" id="personnelPassword" placeholder="Değiştirmek istemiyorsanız boş bırakın">
                            <div id="personnelPasswordHint" class="form-text">Yeni kullanıcı için şifre zorunludur.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Durum</label>
                            <select class="form-select" id="personnelStatus">
                                <option value="1">Aktif</option>
                                <option value="0">Pasif</option>
                            </select>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-cancel" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-save" id="savePersonnelBtn">Kaydet</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios@1.6.2/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <!-- Custom JS -->
    <script src="{{ base_path }}/assets/js/config.js?v={{ version }}"></script>
    <script src="{{ base_path }}/assets/js/clinic-settings.js?v={{ version }}"></script>
</body>
</html>
