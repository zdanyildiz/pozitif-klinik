<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pozitif Klinik - Modern ve Güvenli Klinik Yönetim Platformu">
    <title>{% block title %}Pozitif Klinik | Yeni Nesil Klinik Yönetimi{% endblock %}</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Outfit:wght@500;700&display=swap" rel="stylesheet">
    
    <!-- Frontend Custom CSS -->
    <link href="{{ base_path }}/assets/css/frontend.css?v={{ version }}" rel="stylesheet">
</head>
<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/">
                <i class="bi bi-hospital-fill"></i>
                Pozitif Klinik
            </a>
            
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation" style="filter: invert(1);">
                <span class="navbar-toggler-icon"></span>
            </button>
            
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto mb-2 mb-lg-0 me-3">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Ana Sayfa</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/hakkimizda">Hakkımızda</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/iletisim">İletişim</a>
                    </li>
                </ul>
                <div class="d-flex gap-3 align-items-center">
                    <a href="/admin/login" class="nav-login-btn">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Klinik Girişi
                    </a>
                </div>
            </div>
        </div>
    </nav>

    {% block content %}{% endblock %}

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="footer-content">
                <div class="footer-brand">
                    <h4>Pozitif Klinik</h4>
                    <p>Klinik yönetiminde yeni nesil, güvenli ve bulut tabanlı çözüm ortağınız.</p>
                </div>
                
                <div class="footer-links">
                    <h5>Kurumsal</h5>
                    <ul>
                        <li><a href="/hakkimizda">Hakkımızda</a></li>
                        <li><a href="/iletisim">İletişim</a></li>
                    </ul>
                </div>
                
                <div class="footer-links">
                    <h5>Hukuki</h5>
                    <ul>
                        <li><a href="/kvkk">KVKK Metni</a></li>
                        <li><a href="/acik-riza-metni">Açık Rıza Metni</a></li>
                        <li><a href="/aydinlatma-metni">Aydınlatma Metni</a></li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                &copy; {{ "now"|date("Y") }} Pozitif Klinik Yönetim Platformu. Tüm hakları saklıdır.
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
