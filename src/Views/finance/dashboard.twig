{% extends 'layout.twig' %}

{% block page_title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="row mb-4">
    <!-- Günlük Ciro -->
    <div class="col-md-4">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Bugünkü Ciro</h6>
                        <h2 class="mb-0">{{ totalToday|number_format(2) }} ₺</h2>
                    </div>
                    <i class="fs-1 bi-wallet2 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Bekleyen Alacak -->
    <div class="col-md-4">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Toplam Bekleyen Alacak</h6>
                        <h2 class="mb-0">{{ pendingTotal|number_format(2) }} ₺</h2>
                        <small>{{ pendingCount }} kayıt</small>
                    </div>
                    <i class="fs-1 bi-hourglass-split text-muted"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Kasa Durumu (Placeholder) -->
    <div class="col-md-4">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Haftalık Hedef</h6>
                        <h2 class="mb-0">-- %</h2>
                    </div>
                    <i class="fs-1 bi-graph-up-arrow text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Ödeme Tipi Dağılımı -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Bugünkü Ödeme Tipleri</h5>
            </div>
            <div class="card-body">
                {% if summary %}
                    <ul class="list-group list-group-flush">
                        {% for item in summary %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {% if item.payment_type == 'cash' %} Nakit
                                {% elseif item.payment_type == 'credit_card' %} Kredi Kartı
                                {% elseif item.payment_type == 'bank_transfer' %} Havale/EFT
                                {% else %} Diğer {% endif %}
                            </span>
                            <span class="fw-bold">{{ item.total_amount|number_format(2) }} ₺</span>
                        </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted text-center py-4">Henüz işlem yok.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Son İşlemler -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Son Hareketler</h5>
                <a href="/admin/finance/transactions" class="btn btn-sm btn-outline-primary">Tümü</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead>
                            <tr>
                                <th>Hasta</th>
                                <th>Tutar</th>
                                <th>Tip</th>
                                <th>Saat</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in recentTransactions %}
                            <tr>
                                <td>{{ item.patient_name }}</td>
                                <td class="fw-bold text-success">+{{ item.amount|number_format(2) }} ₺</td>
                                <td>
                                    {% if item.payment_type == 'cash' %} <span class="badge bg-success">N</span>
                                    {% elseif item.payment_type == 'credit_card' %} <span class="badge bg-info">K</span>
                                    {% else %} <span class="badge bg-secondary">D</span> {% endif %}
                                </td>
                                <td>{{ item.payment_date|date('H:i') }}</td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted">Kayıt yok</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'finance/modals/payment_modal.twig' %}
{% endblock %}
