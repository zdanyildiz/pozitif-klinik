{% extends 'layout.twig' %}

{% block page_title %}{{ pageTitle }}{% endblock %}

{% block content %}
<div class="row mb-4">
    <!-- Günlük Ciro -->
    <div class="col-md-4">
        <div class="card bg-success text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Bugünkü Ciro</h6>
                        <h2 class="mb-0">{{ totalToday|number_format(2) }} ₺</h2>
                    </div>
                    <i class="fs-1 bi-wallet2 text-white-50"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Bekleyen Alacak -->
    <div class="col-md-4">
        <div class="card bg-warning text-dark h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-muted">Toplam Bekleyen Alacak</h6>
                        <h2 class="mb-0">{{ pendingTotal|number_format(2) }} ₺</h2>
                        <small>{{ pendingCount }} kayıt</small>
                    </div>
                    <i class="fs-1 bi-hourglass-split text-muted"></i>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Kasa Durumu (Placeholder) -->
    <div class="col-md-4">
        <div class="card bg-info text-white h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-white-50">Haftalık Ciro</h6>
                        <h2 class="mb-0">{{ thisWeekTotal|number_format(2) }} ₺</h2>
                        <div class="small mt-1">
                            {% if trendPercent > 0 %}
                                <span class="fw-bold"><i class="bi bi-arrow-up"></i> %{{ trendPercent|number_format(1) }}</span> <span class="text-white-50">geçen haftaya göre</span>
                            {% elseif trendPercent < 0 %}
                                <span class="fw-bold"><i class="bi bi-arrow-down"></i> %{{ trendPercent|abs|number_format(1) }}</span> <span class="text-white-50">geçen haftaya göre</span>
                            {% else %}
                                <span class="text-white-50">Değişim Yok</span>
                            {% endif %}
                        </div>
                    </div>
                    <i class="fs-1 bi-graph-up-arrow text-white-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row mb-4">
    <div class="col-12">
        <div class="card border-warning">
            <div class="card-header bg-warning cx-bg-opacity-10 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 text-dark"><i class="bi bi-exclamation-circle me-2"></i>Bekleyen Ödemeler (Tahsilat Listesi)</h5>
                <a href="/admin/finance/pending" class="btn btn-sm btn-outline-dark">Tümünü Gör</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Hasta</th>
                                <th>Doktor</th>
                                <th class="text-end">Toplam Borç</th>
                                <th class="text-end">Ödenen</th>
                                <th class="text-end text-danger">Kalan Bakiye</th>
                                <th class="text-end" style="width: 150px;">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in pendingPayments %}
                            <tr>
                                <td>
                                    <div class="fw-bold">{{ item.appointment_date|date('d.m.Y') }}</div>
                                    <small class="text-muted">{{ item.appointment_date|date('H:i') }}</small>
                                </td>
                                <td>
                                    <div class="fw-bold">{{ item.patient_name }}</div>
                                    <small class="text-muted">{{ item.patient_phone }}</small>
                                </td>
                                <td>{{ item.doctor_name }}</td>
                                <td class="text-end">{{ item.total_debt|number_format(2) }} ₺</td>
                                <td class="text-end text-success">{{ item.total_paid|number_format(2) }} ₺</td>
                                <td class="text-end fw-bold text-danger">{{ item.remaining_amount|number_format(2) }} ₺</td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-primary btn-collect shadow-sm" 
                                            data-patient-id="{{ item.patient_id }}"
                                            data-appointment-id="{{ item.appointment_id }}"
                                            data-remaining="{{ item.remaining_amount }}">
                                        <i class="bi bi-wallet2 me-1"></i> Tahsil Et
                                    </button>
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="7" class="text-center py-4 text-muted">
                                    <i class="bi bi-check-circle fs-2 d-block mb-2"></i>
                                    Bekleyen ödeme bulunmuyor.
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <!-- Ödeme Tipi Dağılımı -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header">
                <h5 class="card-title mb-0">Bugünkü Ödeme Tipleri</h5>
            </div>
            <div class="card-body">
                {% if summary %}
                    <ul class="list-group list-group-flush">
                        {% for item in summary %}
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>
                                {% if item.payment_type == 'cash' %} Nakit
                                {% elseif item.payment_type == 'credit_card' %} Kredi Kartı
                                {% elseif item.payment_type == 'bank_transfer' %} Havale/EFT
                                {% else %} Diğer {% endif %}
                            </span>
                            <span class="fw-bold">{{ item.total_amount|number_format(2) }} ₺</span>
                        </li>
                        {% endfor %}
                    </ul>
                {% else %}
                    <p class="text-muted text-center py-4">Henüz işlem yok.</p>
                {% endif %}
            </div>
        </div>
    </div>

    <!-- Son İşlemler -->
    <div class="col-md-6 mb-4">
        <div class="card h-100">
            <div class="card-header d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0">Son Hareketler</h5>
                <a href="/admin/finance/transactions" class="btn btn-sm btn-outline-primary">Tümü</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead>
                            <tr>
                                <th>Tarih</th>
                                <th>Hasta</th>
                                <th class="text-end">Tutar</th>
                                <th class="text-center">Tip</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for item in recentTransactions %}
                            <tr>
                                <td>
                                    <div class="fw-bold">{{ item.payment_date|date('d.m.Y') }}</div>
                                    <small class="text-muted">{{ item.payment_date|date('H:i') }}</small>
                                </td>
                                <td>{{ item.patient_name }}</td>
                                <td class="fw-bold text-success text-end">+{{ item.amount|number_format(2) }} ₺</td>
                                <td class="text-center">
                                    {% if ',' in item.payment_type %}
                                        <span class="badge bg-warning text-dark" title="{{ item.payment_type }}">M</span>
                                    {% elseif item.payment_type == 'cash' %} 
                                        <span class="badge bg-success">N</span>
                                    {% elseif item.payment_type == 'credit_card' %} 
                                        <span class="badge bg-info">K</span>
                                    {% else %} 
                                        <span class="badge bg-secondary">D</span> 
                                    {% endif %}
                                </td>
                                <td class="text-end">
                                    {% if item.appointment_id %}
                                        <button class="btn btn-sm btn-outline-primary" onclick="openPaymentDetail({{ item.appointment_id }}, '{{ item.payment_date|date('Y-m-d') }}')">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    {% endif %}
                                </td>
                            </tr>
                            {% else %}
                            <tr>
                                <td colspan="5" class="text-center text-muted py-4">Kayıt yok</td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'components/payment_modal.twig' %}
{% include 'finance/modals/payment_detail_modal.twig' %}
{% endblock %}

{% block scripts %}
<script>
    function openPaymentDetail(appointmentId, dateGroup = '') {
        const modalEl = document.getElementById('paymentDetailModal');
        const modal = new bootstrap.Modal(modalEl);
        
        const contentDiv = document.getElementById('paymentDetailContent');
        contentDiv.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Yükleniyor...</p></div>';
        
        modal.show();

        const url = '/api/payments/transaction-detail/' + appointmentId + (dateGroup ? '?date=' + dateGroup : '');
        api.get(url)
            .then(res => {
                const data = res.data;
                let html = '';

                html += '<h6 class="fw-bold mb-3">Hizmet Dökümü</h6>';
                html += '<table class="table table-sm table-bordered mb-4">';
                html += '<thead class="table-light"><tr><th>Hizmet</th><th>Tutar</th></tr></thead><tbody>';
                
                if (data.services.length === 0) {
                     html += '<tr><td colspan="2" class="text-center text-muted">Hizmet kaydı bulunamadı.</td></tr>';
                } else {
                    data.services.forEach(item => {
                        html += `<tr>
                            <td>${item.item_name}</td>
                            <td class="text-end">${parseFloat(item.total_price).toFixed(2)} ₺</td>
                        </tr>`;
                    });
                }
                html += '</tbody></table>';

                const summary = data.summary;
                html += '<div class="row mb-4">';
                html += `<div class="col-4"><div class="border rounded p-2 text-center bg-light"><small>Toplam Borç</small><div class="fw-bold">${summary.total_debt.toFixed(2)} ₺</div></div></div>`;
                html += `<div class="col-4"><div class="border rounded p-2 text-center bg-light"><small>Toplam Ödenen</small><div class="fw-bold text-success">${summary.total_paid.toFixed(2)} ₺</div></div></div>`;
                html += `<div class="col-4"><div class="border rounded p-2 text-center ${summary.balance > 0 ? 'bg-danger-subtle' : 'bg-success-subtle'}"><small>Kalan</small><div class="fw-bold">${summary.balance.toFixed(2)} ₺</div></div></div>`;
                html += '</div>';

                html += '<h6 class="fw-bold mb-3">Bu Randevuya Ait Ödemeler</h6>';
                html += '<ul class="list-group">';
                data.payments.forEach(pay => {
                    const date = new Date(pay.payment_date).toLocaleString('tr-TR');
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">${date}</span> <span class="badge bg-secondary ms-2">${pay.payment_type}</span>
                        </div>
                        <span class="fw-bold">${parseFloat(pay.amount).toFixed(2)} ₺</span>
                    </li>`;
                });
                html += '</ul>';

                contentDiv.innerHTML = html;
            })
            .catch(err => {
                console.error(err);
                contentDiv.innerHTML = '<div class="alert alert-danger">Veri yüklenirken hata oluştu.</div>';
            });
    }

    // Payment Module Integration for Dashboard
    document.addEventListener('DOMContentLoaded', () => {
        // Collect buttons (Tahsil Et)
        document.querySelectorAll('.btn-collect').forEach(btn => {
            btn.onclick = (e) => {
                e.preventDefault();
                const appointmentId = btn.dataset.appointmentId;

                if (appointmentId) {
                    // Open the shared payment modal for this appointment
                    if (typeof PaymentModule !== 'undefined') {
                        // PaymentModule.refresh handles fetching data and opening the modal correctly
                        PaymentModule.refresh(appointmentId);
                    } else {
                        console.error('PaymentModule not loaded');
                    }
                }
            };
        });

        // Listen for successful payments to refresh the dashboard
        window.addEventListener('payment-saved', () => {
            // Optional: Show success message then reload
            setTimeout(() => {
                window.location.reload();
            }, 1000);
        });
    });
</script>
<script src="{{ base_path }}/assets/js/finance-shared.js?v={{ version }}"></script>
{% endblock %}
