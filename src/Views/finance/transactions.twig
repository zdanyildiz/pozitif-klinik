{% extends 'layout.twig' %}

{% block page_title %}Kasa Hareketleri{% endblock %}

{% block content %}
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" action="/admin/finance/transactions" class="row g-3 align-items-end">
            <div class="col-md-3">
                <label for="search" class="form-label">Arama (TC No)</label>
                <input type="text" class="form-control" id="search" name="q" value="{{ filters.search }}" placeholder="TC Kimlik No...">
            </div>
            <div class="col-md-2">
                <label for="start_date" class="form-label">Başlangıç</label>
                <input type="date" class="form-control" id="start_date" name="start_date" value="{{ filters.start_date }}">
            </div>
            <div class="col-md-2">
                <label for="end_date" class="form-label">Bitiş</label>
                <input type="date" class="form-control" id="end_date" name="end_date" value="{{ filters.end_date }}">
            </div>
            <div class="col-md-3">
                <label for="payment_type" class="form-label">Ödeme Tipi</label>
                <select class="form-select" id="payment_type" name="payment_type">
                    <option value="">Tümü</option>
                    <option value="cash" {% if filters.payment_type == 'cash' %}selected{% endif %}>Nakit</option>
                    <option value="credit_card" {% if filters.payment_type == 'credit_card' %}selected{% endif %}>Kredi Kartı</option>
                    <option value="bank_transfer" {% if filters.payment_type == 'bank_transfer' %}selected{% endif %}>Havale/EFT</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-filter"></i> Filtrele</button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-0">İşlem Listesi</h5>
            <small class="text-muted">Toplam {{ totalCount }} işlem bulundu.</small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Yazdır</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Hasta</th>
                        <th>Ödeme Yöntemi</th>
                        <th>İşlem Sayısı</th>
                        <th class="text-end">Toplam Tutar</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in transactions %}
                    <tr>
                        <td>
                            <div class="fw-bold">{{ item.last_payment_date|date('d.m.Y') }}</div>
                            <small class="text-muted">{{ item.last_payment_date|date('H:i') }}</small>
                        </td>
                        <td>
                            <div>{{ item.patient_name }}</div>
                            <small class="text-muted">{{ item.patient_tc }}</small>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark border">{{ item.payment_types_label }}</span>
                        </td>
                        <td>
                            {% if item.item_count > 1 %}
                                <span class="badge bg-info rounded-pill">{{ item.item_count }} Parçalı Ödeme</span>
                            {% else %}
                                <span class="text-muted">-</span>
                            {% endif %}
                        </td>
                        <td class="text-end fw-bold text-success">{{ item.total_amount|number_format(2) }} ₺</td>
                        <td class="text-end">
                            {% if item.appointment_id %}
                                <button class="btn btn-sm btn-outline-primary" onclick="openPaymentDetail({{ item.appointment_id }})">
                                    <i class="bi bi-eye"></i> Detay
                                </button>
                            {% else %}
                                <button class="btn btn-sm btn-outline-secondary" disabled>
                                    <i class="bi bi-dash-circle"></i>
                                </button>
                            {% endif %}
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="6" class="text-center text-muted py-5">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            Aradığınız kriterlere uygun kayıt bulunamadı.
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Pagination -->
    {% if totalPages > 1 %}
    <div class="card-footer d-flex justify-content-center">
        <nav>
            <ul class="pagination mb-0">
                <li class="page-item {% if currentPage == 1 %}disabled{% endif %}">
                    <a class="page-link" href="?page={{ currentPage - 1 }}&{{ filters|url_encode }}">Önceki</a>
                </li>
                {% for i in 1..totalPages %}
                    <li class="page-item {% if currentPage == i %}active{% endif %}">
                        <a class="page-link" href="?page={{ i }}&{{ filters|url_encode }}">{{ i }}</a>
                    </li>
                {% endfor %}
                <li class="page-item {% if currentPage == totalPages %}disabled{% endif %}">
                    <a class="page-link" href="?page={{ currentPage + 1 }}&{{ filters|url_encode }}">Sonraki</a>
                </li>
            </ul>
        </nav>
    </div>
    {% endif %}
</div>

{% include 'finance/modals/payment_detail_modal.twig' %}

{% endblock %}

{% block scripts %}
<script>
    function openPaymentDetail(appointmentId) {
        const modalEl = document.getElementById('paymentDetailModal');
        const modal = new bootstrap.Modal(modalEl);
        
        // Yükleniyor göster
        const contentDiv = document.getElementById('paymentDetailContent');
        contentDiv.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Yükleniyor...</p></div>';
        
        modal.show();

        // Veriyi çek
        api.get('/api/payments/transaction-detail/' + appointmentId)
            .then(res => {
                const data = res.data;
                let html = '';

                // 1. Hizmetler Tablosu
                html += '<h6 class="fw-bold mb-3">Hizmet Dökümü</h6>';
                html += '<table class="table table-sm table-bordered mb-4">';
                html += '<thead class="table-light"><tr><th>Hizmet</th><th>Tutar</th></tr></thead><tbody>';
                
                if (data.services.length === 0) {
                     html += '<tr><td colspan="2" class="text-center text-muted">Hizmet kaydı bulunamadı.</td></tr>';
                } else {
                    data.services.forEach(item => {
                        html += `<tr>
                            <td>${item.item_name}</td>
                            <td class="text-end">${parseFloat(item.total_price).toFixed(2)} ₺</td>
                        </tr>`;
                    });
                }
                html += '</tbody></table>';

                // 2. Özet Bilgiler
                const summary = data.summary;
                html += '<div class="row mb-4">';
                html += `<div class="col-4"><div class="border rounded p-2 text-center bg-light"><small>Toplam Borç</small><div class="fw-bold">${summary.total_debt.toFixed(2)} ₺</div></div></div>`;
                html += `<div class="col-4"><div class="border rounded p-2 text-center bg-light"><small>Toplam Ödenen</small><div class="fw-bold text-success">${summary.total_paid.toFixed(2)} ₺</div></div></div>`;
                html += `<div class="col-4"><div class="border rounded p-2 text-center ${summary.balance > 0 ? 'bg-danger-subtle' : 'bg-success-subtle'}"><small>Kalan</small><div class="fw-bold">${summary.balance.toFixed(2)} ₺</div></div></div>`;
                html += '</div>';

                // 3. Ödeme Geçmişi
                html += '<h6 class="fw-bold mb-3">Bu Randevuya Ait Ödemeler</h6>';
                html += '<ul class="list-group">';
                data.payments.forEach(pay => {
                    const date = new Date(pay.payment_date).toLocaleString('tr-TR');
                    // Tip çevirisi size kalmış, basitce yazıyorum
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">${date}</span> <span class="badge bg-secondary ms-2">${pay.payment_type}</span>
                        </div>
                        <span class="fw-bold">${parseFloat(pay.amount).toFixed(2)} ₺</span>
                    </li>`;
                });
                html += '</ul>';

                contentDiv.innerHTML = html;
            })
            .catch(err => {
                console.error(err);
                contentDiv.innerHTML = '<div class="alert alert-danger">Veri yüklenirken hata oluştu.</div>';
            });
    }
</script>
{% endblock %}
