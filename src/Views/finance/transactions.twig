{% extends 'layout.twig' %}

{% block page_title %}Kasa Hareketleri{% endblock %}

{% block content %}
<div class="card mb-4">
    <div class="card-body">
        <form method="GET" action="/admin/finance/transactions" class="row g-3 align-items-end" id="transactionsForm">
            <div class="col-md-3">
                <label class="form-label small">İsim / TC No</label>
                <input type="text" name="q" class="form-control" placeholder="Tam ad veya TC..." value="{{ filters.q }}">
            </div>
            <div class="col-md-2">
                <label for="start_date" class="form-label">Başlangıç</label>
                <input type="date" class="form-control" id="start_date" name="start_date" value="{{ filters.start_date }}">
            </div>
            <div class="col-md-2">
                <label for="end_date" class="form-label">Bitiş</label>
                <input type="date" class="form-control" id="end_date" name="end_date" value="{{ filters.end_date }}">
            </div>
            <div class="col-md-3">
                <label for="payment_type" class="form-label">Ödeme Tipi</label>
                <select class="form-select" id="payment_type" name="payment_type">
                    <option value="">Tümü</option>
                    <option value="cash" {% if filters.payment_type == 'cash' %}selected{% endif %}>Nakit</option>
                    <option value="credit_card" {% if filters.payment_type == 'credit_card' %}selected{% endif %}>Kredi Kartı</option>
                    <option value="bank_transfer" {% if filters.payment_type == 'bank_transfer' %}selected{% endif %}>Havale/EFT</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Ara
                </button>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <h5 class="card-title mb-0">İşlem Listesi</h5>
            <small class="text-muted" id="totalCountDisplay">Toplam {{ totalCount }} işlem bulundu.</small>
        </div>
        <button class="btn btn-outline-secondary btn-sm" onclick="window.print()"><i class="bi bi-printer"></i> Yazdır</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle" id="transactionsTable">
                <thead>
                    <tr>
                        <th>Tarih</th>
                        <th>Hasta</th>
                        <th>Ödeme Yöntemi</th>
                        <th>İşlem Sayısı</th>
                        <th class="text-end">Toplam Tutar</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="transactionTableBody">
                    {% include 'finance/partials/transaction_rows.twig' %}
                </tbody>
            </table>
        </div>
    </div>
    
    <!-- Pagination -->
    <div id="paginationWrapper">
        {% include 'finance/partials/pagination.twig' %}
    </div>
</div>

{% include 'finance/modals/payment_detail_modal.twig' %}

{% endblock %}

{% block scripts %}
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const form = document.getElementById('transactionsForm');
        const searchInput = document.querySelector('input[name="q"]');
        let debounceTimeout = null;

        // Form Submit Handler (AJAX Search)
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            const formData = new FormData(form);
            const params = new URLSearchParams(formData);
            const url = form.action + '?' + params.toString();
            updateTable(url);
        });

        // Debounced Input
        if (searchInput) {
            searchInput.addEventListener('input', () => {
                clearTimeout(debounceTimeout);
                debounceTimeout = setTimeout(() => {
                    form.dispatchEvent(new Event('submit'));
                }, 800); 
            });
        }

        // Pagination Clicks (Delegation)
        document.getElementById('paginationWrapper').addEventListener('click', (e) => {
            const link = e.target.closest('.page-link');
            if (link && !link.closest('.disabled')) {
                e.preventDefault();
                const url = link.href;
                updateTable(url);
            }
        });

        // Browser Back/Forward
        window.addEventListener('popstate', () => {
            updateTable(window.location.href, false);
        });
    });

    function updateTable(url, pushState = true) {
        const tbody = document.getElementById('transactionTableBody');
        const paginationWrapper = document.getElementById('paginationWrapper');
        const totalCountDisplay = document.getElementById('totalCountDisplay');
        const table = document.getElementById('transactionsTable');

        // Loading State
        table.style.opacity = '0.5';

        api.get(url, { headers: { 'X-Requested-With': 'XMLHttpRequest' } })
            .then(res => {
                const data = res.data;
                
                // Update Content
                if (data.html) {
                    tbody.innerHTML = data.html;
                }
                if (data.pagination) {
                    paginationWrapper.innerHTML = data.pagination;
                } else {
                    paginationWrapper.innerHTML = '';
                }
                if (data.totalCount !== undefined) {
                    totalCountDisplay.innerText = `Toplam ${data.totalCount} işlem bulundu.`;
                }

                // Update URL
                if (pushState) {
                    history.pushState(null, '', url);
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire({
                    icon: 'error',
                    title: 'Hata',
                    text: 'Arama sırasında bir hata oluştu. Lütfen tekrar deneyin.',
                    confirmButtonText: 'Tamam'
                });
            })
            .finally(() => {
                table.style.opacity = '1';
            });
    }

    function openPaymentDetail(appointmentId, dateGroup = '') {
        const modalEl = document.getElementById('paymentDetailModal');
        const modal = new bootstrap.Modal(modalEl);
        
        // Yükleniyor göster
        const contentDiv = document.getElementById('paymentDetailContent');
        contentDiv.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div><p class="mt-2">Yükleniyor...</p></div>';
        
        modal.show();

        // Veriyi çek
        const url = '/api/payments/transaction-detail/' + appointmentId + (dateGroup ? '?date=' + dateGroup : '');
        api.get(url)
            .then(res => {
                const data = res.data;
                let html = '';

                // 1. Hizmetler Tablosu
                html += '<h6 class="fw-bold mb-3">Hizmet Dökümü</h6>';
                html += '<table class="table table-sm table-bordered mb-4">';
                html += '<thead class="table-light"><tr><th>Hizmet</th><th>Tutar</th></tr></thead><tbody>';
                
                if (data.services.length === 0) {
                     html += '<tr><td colspan="2" class="text-center text-muted">Hizmet kaydı bulunamadı.</td></tr>';
                } else {
                    data.services.forEach(item => {
                        html += `<tr>
                            <td>${item.item_name}</td>
                            <td class="text-end">${parseFloat(item.total_price).toFixed(2)} ₺</td>
                        </tr>`;
                    });
                }
                html += '</tbody></table>';

                // 2. Özet Bilgiler
                const summary = data.summary;
                html += '<div class="row mb-4">';
                html += `<div class="col-4"><div class="border rounded p-2 text-center bg-light"><small>Toplam Borç</small><div class="fw-bold">${summary.total_debt.toFixed(2)} ₺</div></div></div>`;
                html += `<div class="col-4"><div class="border rounded p-2 text-center bg-light"><small>Toplam Ödenen</small><div class="fw-bold text-success">${summary.total_paid.toFixed(2)} ₺</div></div></div>`;
                html += `<div class="col-4"><div class="border rounded p-2 text-center ${summary.balance > 0 ? 'bg-danger-subtle' : 'bg-success-subtle'}"><small>Kalan</small><div class="fw-bold">${summary.balance.toFixed(2)} ₺</div></div></div>`;
                html += '</div>';

                // 3. Ödeme Geçmişi
                html += '<h6 class="fw-bold mb-3">Bu Randevuya Ait Ödemeler</h6>';
                html += '<ul class="list-group">';
                data.payments.forEach(pay => {
                    const date = new Date(pay.payment_date).toLocaleString('tr-TR');
                    html += `<li class="list-group-item d-flex justify-content-between align-items-center">
                        <div>
                            <span class="fw-medium">${date}</span> <span class="badge bg-secondary ms-2">${pay.payment_type}</span>
                        </div>
                        <span class="fw-bold">${parseFloat(pay.amount).toFixed(2)} ₺</span>
                    </li>`;
                });
                html += '</ul>';

                contentDiv.innerHTML = html;
            })
            .catch(err => {
                console.error(err);
                contentDiv.innerHTML = '<div class="alert alert-danger">Veri yüklenirken hata oluştu.</div>';
            });
    }
</script>
{% endblock %}
