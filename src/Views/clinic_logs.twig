{% extends 'layout.twig' %}

{% block page_title %}İşlem Geçmişi (Denetim Kayıtları){% endblock %}

{% block content %}
<div class="row mb-4">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <form id="filterForm" class="row g-3">
                    <div class="col-md-3">
                        <label for="moduleFilter" class="form-label text-muted small">Modül</label>
                        <select class="form-select" id="moduleFilter">
                            <option value="">Tümü</option>
                            <option value="PATIENT">Hasta Yönetimi</option>
                            <option value="APPOINTMENT">Randevu Yönetimi</option>
                            <option value="FINANCE">Finans / Adisyon</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="startDate" class="form-label text-muted small">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" id="startDate">
                    </div>
                    <div class="col-md-3">
                        <label for="endDate" class="form-label text-muted small">Bitiş Tarihi</label>
                        <input type="date" class="form-control" id="endDate">
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-filter"></i> Filtrele
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Tarih</th>
                                <th>Kullanıcı</th>
                                <th>Modül</th>
                                <th>İşlem</th>
                                <th>Açıklama</th>
                                <th class="text-end pe-4">Detay</th>
                            </tr>
                        </thead>
                        <tbody id="logsTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <div class="spinner-border text-primary" role="status">
                                        <span class="visually-hidden">Yükleniyor...</span>
                                    </div>
                                    <div class="mt-2">Kayıtlar yükleniyor...</div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer bg-white border-top py-3">
                <nav>
                    <ul class="pagination justify-content-center mb-0" id="pagination">
                        <!-- Pagination JS ile doldurulacak -->
                    </ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<!-- Log Detay Modalı -->
<div class="modal fade" id="logDetailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">İşlem Detayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label text-muted">Önceki Değerler</label>
                        <pre class="bg-light p-3 rounded small" id="oldValuesInfo" style="max-height: 300px; overflow-y: auto;">-</pre>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label text-muted">Yeni Değerler</label>
                        <pre class="bg-light p-3 rounded small" id="newValuesInfo" style="max-height: 300px; overflow-y: auto;">-</pre>
                    </div>
                    <div class="col-12">
                        <div class="alert alert-info d-flex align-items-center mb-0">
                            <i class="bi bi-info-circle me-2"></i>
                            <div id="metaInfo">
                                <!-- IP Adresi vb. -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ base_path }}/assets/js/clinic_logs.js?v={{ version }}"></script>
{% endblock %}
