<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Pozitif Klinik Platform Yönetim Paneli - Giriş">
    <title>Admin Girişi | Pozitif Klinik Platform</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.css" rel="stylesheet">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Custom CSS -->
    <link href="{{ base_path }}/assets/css/login.css?v={{ version }}" rel="stylesheet">
</head>
<body>
    <!-- Animated Background Shapes -->
    <div class="bg-shapes">
        <div class="shape"></div>
        <div class="shape"></div>
        <div class="shape"></div>
    </div>

    <!-- Login Container -->
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="login-logo">
                    <i class="bi bi-hospital"></i>
                </div>
                <h1>Klinik Yönetimi</h1>
                <p>Klinik hesabınızla giriş yapın</p>
            </div>

            {% if error %}
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-circle me-2"></i>{{ error }}
            </div>
            {% endif %}

            <form method="POST" action="{{ base_path }}/admin/login" autocomplete="off">
                <input type="hidden" name="{{ csrf.keys.name }}" value="{{ csrf.name }}">
                <input type="hidden" name="{{ csrf.keys.value }}" value="{{ csrf.value }}">
                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="clinic_code" name="clinic_code"
                        placeholder="örn: pozitif" value="{{ clinic_code }}" required autofocus>
                    <label for="clinic_code">
                        <i class="bi bi-building me-2"></i>Kurum Kodu
                    </label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" class="form-control" id="username" name="username" placeholder="Kullanıcı Adı"
                        value="{{ username }}" required>
                    <label for="username">
                        <i class="bi bi-person me-2"></i>Kullanıcı Adı
                    </label>
                </div>

                <div class="form-floating password-wrapper mb-4">
                    <input type="password" class="form-control" id="password" name="password" placeholder="Şifre"
                        required>
                    <label for="password">
                        <i class="bi bi-lock me-2"></i>Şifre
                    </label>
                    <button type="button" class="password-toggle" aria-label="Şifreyi göster/gizle" onclick="togglePassword()">
                        <i class="bi bi-eye"></i>
                    </button>
                </div>

                <button type="submit" class="btn btn-login mb-3">
                    <span class="btn-text">Giriş Yap</span>
                </button>
            </form>

            <div class="footer-text mt-3">
                <a href="{{ base_path }}/platform/login">
                    <i class="bi bi-shield-lock me-1"></i>Platform Yöneticisi Girişi
                </a>
            </div>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
    function togglePassword() {
        const passwordInput = document.getElementById('password');
        const toggleBtnIcon = document.querySelector('.password-toggle i');
        
        if (passwordInput.type === 'password') {
            passwordInput.type = 'text';
            toggleBtnIcon.classList.remove('bi-eye');
            toggleBtnIcon.classList.add('bi-eye-slash');
        } else {
            passwordInput.type = 'password';
            toggleBtnIcon.classList.remove('bi-eye-slash');
            toggleBtnIcon.classList.add('bi-eye');
        }
    }
    </script>
</body>
</html>
