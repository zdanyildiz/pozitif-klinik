# ==========================================
# Pozitif Klinik - Environment Configuration
# ==========================================

# Uygulama Ortamı
APP_ENV=development
APP_DEBUG=true

# Veritabanı Ayarları
DB_HOST=localhost
DB_NAME=pozitif_klinik
DB_USER=root
DB_PASS=

# ==========================================
# GÜVENLİK ANAHTARLARI
# ==========================================

# JWT İmzalama Anahtarı
# Minimum 32 karakter, rastgele ve güçlü olmalı
# Üretmek için: openssl rand -base64 48
JWT_SECRET=changeme_to_a_secure_random_string_at_least_32_chars

# AES-256 Şifreleme Anahtarı
# ZORUNLU: Tam olarak 64 karakterlik hex string (32 byte)
# Hasta verileri (TC, Telefon, Email, Adres) bu anahtarla şifrelenir
# Üretmek için: openssl rand -hex 32
APP_KEY=a1b2c3d4e5f678901234567890abcdef1234567890abcdef1234567890abcdef

# ==========================================
# LOGLAMA
# ==========================================

# Log Seviyesi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=DEBUG

# ==========================================
# E-POSTA AYARLARI (FALLBACK)
# ==========================================
# Klinik özel ayarı olmayan durumlarda kullanılacak
# varsayılan SMTP sunucu ayarları

# SMTP Sunucu Bilgileri
MAIL_SMTP_HOST=smtp.example.com
MAIL_SMTP_PORT=587
MAIL_SMTP_USER=noreply@example.com
MAIL_SMTP_PASS=your_smtp_password_here

# Şifreleme: none, tls, ssl
MAIL_SMTP_ENCRYPTION=tls

# Gönderen Bilgileri
MAIL_FROM_EMAIL=noreply@example.com
MAIL_FROM_NAME="Pozitif Klinik"
